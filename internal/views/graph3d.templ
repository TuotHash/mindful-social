package views

import "github.com/TuotHash/mindful-social/internal/db"

templ ArgumentGraph3D(viewer *Viewer, data ArgumentGraphData, filters ArgumentGraphFilters) {
	@Layout("3D argument graph", viewer) {
		<div class="graph-page" data-argument-graph-3d data-argument-graph-endpoint="/graph/data" data-graph-author-current={ filters.Author }>
			@templ.Raw(argumentGraphDataScriptHTML(data))
			@templ.Raw(graphFiltersScriptHTML(filters))
			<header class="argument-graph-head">
				<div class="col gap-12">
					<span class="eyebrow">Graph</span>
					<h1 class="h-1">Argument graph</h1>
				</div>
				<div class="argument-graph-stats" aria-label="Graph size">
					<span>{ graphCount(len(data.Nodes), "node") }</span>
					<span>{ graphCount(len(data.Edges), "connection") }</span>
				</div>
			</header>
			<section class="argument-graph-tool">
				<div class="argument-graph-toolbar">
					<label class="argument-graph-search" aria-label="Search graph">
						<span class="material-symbols-outlined">search</span>
						<div class="search-suggest-anchor">
							<input
								type="search"
								name="q"
								data-graph-search
								value={ filters.Query }
								placeholder="Search graph"
								autocomplete="off"
								hx-get="/graph/nodes/suggest"
								hx-trigger="input changed delay:200ms"
								hx-target="#graph3d-search-suggest"
								hx-swap="innerHTML"
							/>
							<div id="graph3d-search-suggest" class="search-suggest" hidden></div>
						</div>
					</label>
					<label class="argument-graph-author" aria-label="Filter by author">
						<span class="material-symbols-outlined">person</span>
						<div class="search-suggest-anchor">
							<input
								type="search"
								name="q"
								data-graph-author
								value={ filters.Author }
								placeholder="Author"
								autocomplete="off"
								hx-get="/users/suggest"
								hx-trigger="input changed delay:200ms"
								hx-target="#graph3d-author-suggest"
								hx-swap="innerHTML"
							/>
							<div id="graph3d-author-suggest" class="search-suggest" hidden></div>
						</div>
					</label>
					<label class="argument-graph-group" aria-label="Filter by group">
						<span class="material-symbols-outlined">group</span>
						<div class="search-suggest-anchor">
							<input
								type="search"
								name="q"
								data-graph-group
								value={ filters.Group }
								placeholder="Group"
								autocomplete="off"
								hx-get="/groups/suggest"
								hx-trigger="input changed delay:200ms"
								hx-target="#graph3d-group-suggest"
								hx-swap="innerHTML"
							/>
							<div id="graph3d-group-suggest" class="search-suggest" hidden></div>
						</div>
					</label>
					<div class="argument-graph-current" data-graph-visible-count>{ graphCount(len(data.Nodes), "node") } visible</div>
				</div>
				<div class="argument-graph-toolbar argument-graph-toolbar-filters">
					<label class="argument-graph-tags" aria-label="Filter by tag">
						<span class="material-symbols-outlined">sell</span>
						<div class="argument-graph-tag-chips" data-graph-tag-chips></div>
						<div class="search-suggest-anchor">
							<input
								type="search"
								name="q"
								data-graph-tag-input
								data-graph-tag-csv={ graphTagsCSV(filters.Tags) }
								placeholder={ tagPlaceholder(len(filters.Tags)) }
								autocomplete="off"
								hx-get="/tags/suggest"
								hx-trigger="input changed delay:200ms"
								hx-target="#graph3d-tag-suggest"
								hx-swap="innerHTML"
							/>
							<div id="graph3d-tag-suggest" class="search-suggest" hidden></div>
						</div>
					</label>
					<fieldset class="argument-graph-types">
						<legend>Types</legend>
						<label class="chip topic">
							<input type="checkbox" value="topic" data-graph-type checked/>
							<span class="dot"></span>
							Topic
						</label>
						<label class="chip view" title="View">
							<input type="checkbox" value="view" data-graph-type checked/>
							<span class="dot"></span>
							Opinion
						</label>
						<label class="chip finding" title="Evidence">
							<input type="checkbox" value="finding" data-graph-type checked/>
							<span class="dot"></span>
							Evidence
						</label>
						<label class="chip comment">
							<input type="checkbox" value="comment" data-graph-type checked/>
							<span class="dot"></span>
							Comment
						</label>
					</fieldset>
					<fieldset class="argument-graph-types argument-graph-kinds" aria-label="Filter by relationship kind">
						<legend>Edge kinds</legend>
						<label class="chip kind-supports" title="Show supporting edges">
							<input type="checkbox" value="supports" data-graph-kind checked/>
							<span class="dot"></span>
							Supports
						</label>
						<label class="chip kind-opposes" title="Show opposing edges">
							<input type="checkbox" value="opposes" data-graph-kind checked/>
							<span class="dot"></span>
							Opposes
						</label>
						<label class="chip kind-related" title="Show related edges">
							<input type="checkbox" value="related" data-graph-kind checked/>
							<span class="dot"></span>
							Related
						</label>
					</fieldset>
					<div class="argument-graph-toggle-group" role="group" aria-label="Filter by recency">
						<span class="argument-graph-toggle-label">When</span>
						<button type="button" class={ graphToggleClass(filters.Since, "") } data-graph-since="">Any</button>
						<button type="button" class={ graphToggleClass(filters.Since, "7d") } data-graph-since="7d">7d</button>
						<button type="button" class={ graphToggleClass(filters.Since, "30d") } data-graph-since="30d">30d</button>
						<button type="button" class={ graphToggleClass(filters.Since, "90d") } data-graph-since="90d">90d</button>
					</div>
					<div class="argument-graph-toggle-group" role="group" aria-label="Filter by source">
						<span class="argument-graph-toggle-label">Source</span>
						<button type="button" class={ graphToggleClass(filters.Sourced, "") } data-graph-sourced="">Any</button>
						<button type="button" class={ graphToggleClass(filters.Sourced, "yes") } data-graph-sourced="yes" title="Only nodes that link to an external source">Sourced</button>
						<button type="button" class={ graphToggleClass(filters.Sourced, "no") } data-graph-sourced="no" title="Only nodes without an external source link">Unsourced</button>
					</div>
					if viewer != nil {
						<div class="argument-graph-toggle-group" role="group" aria-label="Filter by visibility">
							<span class="argument-graph-toggle-label">Visibility</span>
							<button type="button" class={ graphToggleClass(filters.Visibility, "") } data-graph-visibility="">Any</button>
							<button type="button" class={ graphToggleClass(filters.Visibility, "public") } data-graph-visibility="public">Public</button>
							<button type="button" class={ graphToggleClass(filters.Visibility, "connections") } data-graph-visibility="connections">Conn.</button>
							<button type="button" class={ graphToggleClass(filters.Visibility, "group") } data-graph-visibility="group">Group</button>
							<button type="button" class={ graphToggleClass(filters.Visibility, "private") } data-graph-visibility="private" title="Your own private nodes only">Private</button>
						</div>
					}
					<label class="argument-graph-depth" title="How many extra hops of connected nodes to include around each match.">
						<span class="argument-graph-depth-label">Depth</span>
						<input
							type="range"
							min="0"
							max="5"
							step="1"
							value="2"
							data-graph-depth
							aria-label="Levels of connections shown around each match"
						/>
						<span class="argument-graph-depth-value" data-graph-depth-value aria-live="polite">2</span>
					</label>
					<div class="argument-graph-zoom" aria-label="Graph zoom and view controls">
						<button type="button" class="btn ghost sm" data-graph-zoom="out" title="Zoom out" aria-label="Zoom out">
							<span class="material-symbols-outlined">remove</span>
						</button>
						<button type="button" class="btn ghost sm" data-graph-zoom="reset" title="Reset view" aria-label="Reset view">
							<span class="material-symbols-outlined">center_focus_strong</span>
						</button>
						<button type="button" class="btn ghost sm" data-graph-zoom="in" title="Zoom in" aria-label="Zoom in">
							<span class="material-symbols-outlined">add</span>
						</button>
						<button type="button" class="btn ghost sm" data-graph-reshuffle title="Reshuffle layout" aria-label="Reshuffle layout">
							<span class="material-symbols-outlined">shuffle</span>
						</button>
						<a href="/graph" class="btn ghost sm" title="Switch to 2D view" aria-label="Switch to 2D view">2D</a>
						<a href="/graph/3d" class="btn sm is-active" aria-current="page" title="3D view active">3D</a>
					</div>
				</div>
				<div class="argument-graph-workspace">
					<div class="argument-graph-stage argument-graph-stage-3d">
						<div class="argument-graph-3d-container" data-graph3d-container></div>
					</div>
					<aside class="argument-graph-inspector" aria-live="polite">
						<span class="eyebrow">Selected</span>
						<h2 data-graph-title>Choose a node</h2>
						<div class="argument-graph-meta" data-graph-meta></div>
						<button type="button" class="btn ghost sm" data-graph-author-pin hidden>
							<span class="material-symbols-outlined">filter_alt</span>
							<span data-graph-author-pin-label>Filter by author</span>
						</button>
						<a class="btn accent" href="#" data-graph-open hidden>
							<span class="material-symbols-outlined">open_in_new</span>
							Open node
						</a>
						<div class="argument-graph-legend" aria-label="Relationship kinds">
							<div class="edge-supports"><span class="edge-dot"></span>Supports</div>
							<div class="edge-opposes"><span class="edge-dot"></span>Opposes</div>
							<div class="edge-related"><span class="edge-dot"></span>Related</div>
						</div>
					</aside>
				</div>
				<noscript>
					<div class="argument-graph-noscript">
						if len(data.Nodes) == 0 {
							<p class="muted">No visible nodes yet.</p>
						} else {
							<ul class="node-list">
								for _, n := range data.Nodes {
									<li>
										<a href={ templ.SafeURL("/nodes/" + n.Slug) }>
											<span class={ "chip", n.Type } title={ nodeTypeOriginalLabel(db.NodeType(n.Type)) }>
												<span class="dot"></span>
												{ nodeTypeAliasLabel(db.NodeType(n.Type)) }
											</span>
											<span class="title">{ n.Title }</span>
										</a>
									</li>
								}
							</ul>
						}
					</div>
				</noscript>
			</section>
		</div>
		<script src={ StaticAsset("/static/3d-force-graph.min.js") } defer></script>
		<script src={ StaticAsset("/static/graph3d.js") } defer></script>
	}
}
