package views

import (
	"strconv"

	"github.com/google/uuid"

	"github.com/TuotHash/mindful-social/internal/db"
)

// AdminUserRow is one row in the admin user roster. IsSelf is true when
// this is the viewing admin's own account so the template can disable
// self-demotion (a guard also enforced server-side).
type AdminUserRow struct {
	ID       uuid.UUID
	Username string
	Email    string
	Role     db.UserRole
	IsSelf   bool
}

func roleLabel(r db.UserRole) string {
	switch r {
	case db.UserRoleAdmin:
		return "Admin"
	case db.UserRoleModerator:
		return "Moderator"
	}
	return "User"
}

// allRoles returns every role in the canonical low-to-high order used by
// the role dropdown. Order matters: the select renders options in this
// sequence and the visual rank should match the privilege rank.
func allRoles() []db.UserRole {
	return []db.UserRole{db.UserRoleUser, db.UserRoleModerator, db.UserRoleAdmin}
}

templ AdminUsers(viewer *Viewer, users []AdminUserRow, flash, success string) {
	@Layout("Admin — users", viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Admin</span>
				<h1 class="h-1">Users & roles</h1>
				<p class="muted" style="margin: 0;">Promote moderators to help curate the graph, or grant another admin so you're not the only one with the keys. Moderators can edit and delete any node; admins additionally manage roles.</p>
			</div>
			@Flash(flash)
			if success != "" {
				<div class="flash" role="status" style="background: color-mix(in oklch, var(--supports) 14%, var(--bg)); border-color: color-mix(in oklch, var(--supports) 40%, transparent);">{ success }</div>
			}
			if len(users) == 0 {
				<p class="muted">No users yet.</p>
			} else {
				<ul class="admin-roster">
					for _, u := range users {
						<li class="admin-roster-row">
							<a href={ templ.SafeURL("/users/" + u.Username) } class="admin-roster-main">
								@Avatar(u.Username, 32)
								<div class="col gap-4">
									<div class="row gap-8 wrap" style="align-items: center;">
										<span style="font-weight: 500;">{ u.Username }</span>
										if u.IsSelf {
											<span class="muted" style="font-size: 12px;">(you)</span>
										}
									</div>
									<span class="muted" style="font-size: 12px;">{ u.Email }</span>
								</div>
							</a>
							<div class="admin-roster-actions">
								@adminRoleSelect(u)
								<a class="btn ghost sm icon-only" href={ templ.SafeURL("/admin/users/" + u.ID.String() + "/edit") } title="Edit user" aria-label={ "Edit " + u.Username }>
									@iconPencil()
								</a>
								if !u.IsSelf {
									<a class="btn danger sm icon-only" href={ templ.SafeURL("/admin/users/" + u.ID.String() + "/delete") } title="Delete user" aria-label={ "Delete " + u.Username }>
										@iconTrash()
									</a>
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// adminRoleSelect renders the inline role-change widget. A bare <select>
// inside a tiny form auto-submits on change, so the admin doesn't need a
// separate "save" button. For the viewing admin's own row we disable the
// select — they can't demote themselves and have no other valid choice
// from this widget. The server enforces the same rule independently.
templ adminRoleSelect(u AdminUserRow) {
	<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/role") } class="inline">
		@CSRFField()
		<select name="role" class="role-select" onchange="this.form.submit()" disabled?={ u.IsSelf } aria-label={ "Role for " + u.Username }>
			for _, r := range allRoles() {
				<option value={ string(r) } selected?={ r == u.Role }>{ roleLabel(r) }</option>
			}
		</select>
	</form>
}

// iconPencil is the 16px outline-style edit glyph. Inlined so we don't
// pull in an icon font and so the stroke colour follows currentColor.
templ iconPencil() {
	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 20h9"></path>
		<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
	</svg>
}

// iconTrash is the 16px outline-style delete glyph. Same conventions as
// iconPencil — currentColor for theming, inline for portability.
templ iconTrash() {
	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<polyline points="3 6 5 6 21 6"></polyline>
		<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
		<path d="M10 11v6"></path>
		<path d="M14 11v6"></path>
		<path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
	</svg>
}

// AdminUserEdit is the per-user admin page with three independent forms:
// username, email, password. Each form posts to its own endpoint so a
// validation failure on one doesn't blow away unsaved input on another.
templ AdminUserEdit(viewer *Viewer, target db.User, flash, success string) {
	@Layout("Admin — edit " + target.Username, viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Admin</span>
				<h1 class="h-1">Edit { target.Username }</h1>
				<p class="muted" style="margin: 0;">Change this user's username, email, or password. These actions bypass the usual self-service checks (current password, email verification) — use carefully.</p>
				<p class="muted" style="margin: 0;"><a href="/admin">← Back to roster</a></p>
			</div>
			@Flash(flash)
			if success != "" {
				<div class="flash" role="status" style="background: color-mix(in oklch, var(--supports) 14%, var(--bg)); border-color: color-mix(in oklch, var(--supports) 40%, transparent);">{ success }</div>
			}

			<section class="card" style="padding: 20px;">
				<h2 style="margin-top: 0;">Username</h2>
				<form method="post" action={ templ.SafeURL("/admin/users/" + target.ID.String() + "/username") } class="form">
					@CSRFField()
					<label>
						Username
						<input type="text" name="username" value={ target.Username } required minlength="3" maxlength="32" pattern="[A-Za-z0-9._\\-]+" autocomplete="off"/>
					</label>
					<div class="form-row">
						<button type="submit" class="btn accent">Update username</button>
					</div>
				</form>
			</section>

			<section class="card" style="padding: 20px; margin-top: 24px;">
				<h2 style="margin-top: 0;">Email</h2>
				<form method="post" action={ templ.SafeURL("/admin/users/" + target.ID.String() + "/email") } class="form">
					@CSRFField()
					<label>
						Email
						<input type="email" name="email" value={ target.Email } required autocomplete="off"/>
					</label>
					<div class="form-row">
						<button type="submit" class="btn accent">Update email</button>
					</div>
				</form>
			</section>

			<section class="card" style="padding: 20px; margin-top: 24px;">
				<h2 style="margin-top: 0;">Password</h2>
				<p class="muted" style="margin-top: 0;">Sets a new password without needing the current one. If this user signed up via OAuth and has no password yet, this creates one — they can then sign in by email + password as a fallback.</p>
				<form method="post" action={ templ.SafeURL("/admin/users/" + target.ID.String() + "/password") } class="form">
					@CSRFField()
					<label>
						New password
						<input type="password" name="new_password" required minlength="12" autocomplete="new-password" placeholder="at least 12 characters"/>
					</label>
					<label>
						Confirm new password
						<input type="password" name="confirm_password" required minlength="12" autocomplete="new-password"/>
					</label>
					<div class="form-row">
						<button type="submit" class="btn accent">Reset password</button>
					</div>
				</form>
			</section>
		</div>
	}
}

// AdminUserDelete is the "are you sure?" confirmation page. We render
// the target's username explicitly and call out the cascade so the admin
// understands what they're agreeing to. isSelf only ever shows the
// blocked variant — the admin can navigate here from a bookmarked URL,
// and the server refuses the POST either way.
templ AdminUserDelete(viewer *Viewer, target db.User, nodeCount int64, isSelf bool) {
	@Layout("Admin — delete " + target.Username, viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Admin</span>
				<h1 class="h-1">Delete { target.Username }?</h1>
				<p class="muted" style="margin: 0;"><a href="/admin">← Back to roster</a></p>
			</div>

			<section class="card" style="padding: 20px;">
				if isSelf {
					<p>You can't delete your own account from the admin panel. Ask another admin to do it.</p>
					<div class="form-row">
						<a class="btn ghost" href="/admin">Back to roster</a>
					</div>
				} else {
					<p>Are you sure you want to delete <strong>{ target.Username }</strong>?</p>
					<p class="muted" style="margin-top: 0;">
						This will permanently remove their account
						if nodeCount > 0 {
							, the
							<strong>{ strconv.FormatInt(nodeCount, 10) }</strong>
							if nodeCount == 1 {
								node
							} else {
								nodes
							}
							they authored, every edge attached to those nodes,
						}
						along with their comments, pins, follows, group memberships, and sign-in methods. This action cannot be undone.
					</p>
					<form method="post" action={ templ.SafeURL("/admin/users/" + target.ID.String() + "/delete") } class="form">
						@CSRFField()
						<div class="form-row">
							<button type="submit" class="btn danger">Yes, delete { target.Username }</button>
							<a class="btn ghost" href="/admin">Cancel</a>
						</div>
					</form>
				}
			</section>
		</div>
	}
}
