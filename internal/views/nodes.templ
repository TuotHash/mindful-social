package views

import (
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"
	"github.com/jackc/pgx/v5/pgtype"
	"github.com/TuotHash/mindful-social/internal/db"
)

// NodeNew renders the standalone Post form. Used as a fallback for direct
// URL hits and no-JS clients; the nav button opens NodeNewModal via htmx.
// All three node types — Topic, View, Finding — are creatable here; the
// type toggle drives which extra fields appear via CSS.
templ NodeNew(viewer *Viewer, flash string, formType, formTitle, formBody, formPin, formTags, formVisibility string, groups []db.ListGroupsForUserRow, findParent, formParentNodeID, formTopicParentMode, formFindingEdgeKind string, parentCandidates []TopicCandidate) {
	@Layout("Post", viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Post</span>
				<h1 class="h-1">New post</h1>
				<p class="muted" style="margin: 0;">A view is a stance — that's the standard post. A topic groups views together. A finding attaches an observation to an existing node and says how it relates.</p>
			</div>
			@Flash(flash)
			<form method="post" action="/nodes" class="form post-form">
				@postFormFields(formType, formTitle, formBody, formPin, formTags, formVisibility, groups, findParent, formParentNodeID, formTopicParentMode, formFindingEdgeKind, parentCandidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">send</span>Post</button>
					<a href="/home" class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// NodeNewModal renders the same Post form inside a modal frame. Returned
// when GET /nodes/new arrives with HX-Request: true. Form submit posts
// via htmx; on validation error the server re-renders this fragment, on
// success the handler returns HX-Redirect so htmx does a full navigation.
templ NodeNewModal(flash string, formType, formTitle, formBody, formPin, formTags, formVisibility string, groups []db.ListGroupsForUserRow, findParent, formParentNodeID, formTopicParentMode, formFindingEdgeKind string, parentCandidates []TopicCandidate) {
	<div class="modal-backdrop" onclick="if(event.target===this)document.getElementById('modal').innerHTML=''">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="post-modal-title">
			<button type="button" class="modal-close" aria-label="Close" onclick="document.getElementById('modal').innerHTML=''">
				<span class="material-symbols-outlined">close</span>
			</button>
			<div class="row gap-12 wrap center" style="margin-bottom: 6px;">
				<span class="eyebrow">Post</span>
			</div>
			<h2 id="post-modal-title" style="margin: 0 0 6px; font-size: 22px;">New post</h2>
			<p class="muted" style="margin: 0 0 18px; font-size: 13px;">
				Share a view, start a topic, or attach a finding to an existing node.
			</p>
			@Flash(flash)
			<form
				method="post"
				action="/nodes"
				class="form post-form"
				hx-post="/nodes"
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@postFormFields(formType, formTitle, formBody, formPin, formTags, formVisibility, groups, findParent, formParentNodeID, formTopicParentMode, formFindingEdgeKind, parentCandidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">send</span>Post</button>
					<button type="button" class="btn ghost" onclick="document.getElementById('modal').innerHTML=''"><span class="material-symbols-outlined">close</span>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

// postFormFields are the shared body of NodeNew and NodeNewModal. The outer
// .post-form class enables CSS :has() rules in app.css to hide options that
// don't apply to the selected type: the Position toggle is topic-only,
// Support / Oppose pin are view-only, and the edge-kind toggle is finding-
// only. The parent picker is hidden only when creating a root topic.
templ postFormFields(formType, formTitle, formBody, formPin, formTags, formVisibility string, groups []db.ListGroupsForUserRow, findParent, formParentNodeID, formTopicParentMode, formFindingEdgeKind string, parentCandidates []TopicCandidate) {
	@CSRFField()
	<fieldset class="toggle-group">
		<legend>Type</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-type="view">
				<input type="radio" name="type" value="view" required checked?={ formType == "view" || formType == "" }/>
				<span class="material-symbols-outlined">campaign</span>
				View
			</label>
			<label class="toggle-btn" data-type="topic">
				<input type="radio" name="type" value="topic" checked?={ formType == "topic" }/>
				<span class="material-symbols-outlined">workspaces</span>
				Topic
			</label>
			<label class="toggle-btn" data-type="finding">
				<input type="radio" name="type" value="finding" checked?={ formType == "finding" }/>
				<span class="material-symbols-outlined">fact_check</span>
				Finding
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">A view takes a stance. A topic groups views. A finding attaches an observation to any existing node.</small>
	</fieldset>
	<fieldset class="toggle-group if-topic">
		<legend>Position</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-position="root">
				<input type="radio" name="topic_parent_mode" value="root" checked?={ formTopicParentMode != "sub" }/>
				<span class="material-symbols-outlined">flag</span>
				Root topic
			</label>
			<label class="toggle-btn" data-position="sub">
				<input type="radio" name="topic_parent_mode" value="sub" checked?={ formTopicParentMode == "sub" }/>
				<span class="material-symbols-outlined">subdirectory_arrow_right</span>
				Sub-topic
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">A root topic stands alone. A sub-topic anchors under another topic.</small>
	</fieldset>
	<fieldset class="toggle-group if-finding">
		<legend>Relationship to parent</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-edge-kind="supports">
				<input type="radio" name="finding_edge_kind" value="supports" checked?={ formFindingEdgeKind == "supports" }/>
				<span class="material-symbols-outlined">thumb_up</span>
				Supports
			</label>
			<label class="toggle-btn" data-edge-kind="opposes">
				<input type="radio" name="finding_edge_kind" value="opposes" checked?={ formFindingEdgeKind == "opposes" }/>
				<span class="material-symbols-outlined">thumb_down</span>
				Opposes
			</label>
			<label class="toggle-btn" data-edge-kind="related">
				<input type="radio" name="finding_edge_kind" value="related" checked?={ formFindingEdgeKind == "related" || formFindingEdgeKind == "" }/>
				<span class="material-symbols-outlined">link</span>
				Related
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">How this finding relates to its parent — supports backs it, opposes argues against, related is for citations or loose links.</small>
	</fieldset>
	<label>
		Title
		<input type="text" name="title" required maxlength="200" value={ formTitle } autofocus/>
	</label>
	<label>
		Body
		<textarea
			name="body"
			rows="5"
			class="markdown-editor"
			data-image-endpoint="/nodes/new/images"
			data-image-endpoint-template="/nodes/{id}/images"
			data-image-endpoint-source="parent_node_id"
			data-video-endpoint="/nodes/new/videos"
			data-video-endpoint-template="/nodes/{id}/videos"
			data-video-endpoint-source="parent_node_id"
		>{ formBody }</textarea>
		<small>Optional. Describe the node in your own words. Drop or paste an image, or use the video button to attach a clip.</small>
	</label>
	@nodeVisibilitySelect(formVisibility, groups)
	<fieldset class="toggle-group">
		<legend>Pin to my profile</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-kind="none">
				<input type="radio" name="pin" value="" checked?={ formPin == "" }/>
				<span class="material-symbols-outlined">keep_off</span>
				Don't pin
			</label>
			<label class="toggle-btn" data-kind="featured">
				<input type="radio" name="pin" value="featured" checked?={ formPin == "featured" }/>
				<span class="material-symbols-outlined">keep</span>
				Feature
			</label>
			<label class="toggle-btn if-view" data-kind="supports">
				<input type="radio" name="pin" value="supports" checked?={ formPin == "supports" }/>
				<span class="material-symbols-outlined">heart_plus</span>
				Support
			</label>
			<label class="toggle-btn if-view" data-kind="opposes">
				<input type="radio" name="pin" value="opposes" checked?={ formPin == "opposes" }/>
				<span class="material-symbols-outlined">heart_minus</span>
				Oppose
			</label>
		</div>
	</fieldset>
	<label>
		Tags <small>(comma-separated, optional)</small>
		<input type="text" name="tags" value={ formTags } placeholder="climate, energy, ethics"/>
	</label>
	<div class="parent-picker-section">
		<label>
			<span class="parent-picker-label if-view">Parent topic <span style="color: var(--opposes);">*</span></span>
			<span class="parent-picker-label if-topic">Parent topic <span style="color: var(--opposes);">*</span></span>
			<span class="parent-picker-label if-finding">Parent node <span style="color: var(--opposes);">*</span></span>
			<input
				type="search"
				name="find_parent"
				value={ findParent }
				placeholder="search…"
				autocomplete="off"
				hx-get="/nodes/parent-picker"
				hx-trigger="input changed delay:200ms, search, change from:input[name='type']"
				hx-target="#parent-picker-target"
				hx-swap="outerHTML"
				hx-include="[name='find_parent'],[name='type']"
			/>
			<small class="if-view">Pick the topic this anchors under.</small>
			<small class="if-topic">Pick the topic this anchors under.</small>
			<small class="if-finding">Pick the node this finding attaches to — any topic, view, or finding.</small>
		</label>
		@TopicCandidatePicker(findParent, formParentNodeID, parentCandidates)
	</div>
}

// EdgeRow is one entry in a legend section. Outgoing is true when this row
// represents an edge that *originates* at the current node; false when the
// current node is the destination. Both directions can be highlighted, so
// this flag is informational rather than gating any button.
type EdgeRow struct {
	EdgeID   uuid.UUID
	Kind     db.EdgeKind
	Outgoing bool
	ID       uuid.UUID
	Slug     string
	Type     db.NodeType
	Title    string
}

// EdgeGroup is one section of the legend: a heading ("Supports", "Supported
// by", "Relates to", …) and the rows that fall under it.
type EdgeGroup struct {
	Label string
	Kind  db.EdgeKind
	Rows  []EdgeRow
}

// FeaturedRow is one card in the "Key findings" section, where the
// destination node's body is rendered inline rather than just linked.
type FeaturedRow struct {
	EdgeID uuid.UUID
	Kind   db.EdgeKind
	Label  string // human-readable kind, e.g. "Supports"
	ID     uuid.UUID
	Slug   string
	Type   db.NodeType
	Title  string
	Body   string
}

// PinInfo is non-nil when the current viewer has pinned the node being
// rendered. Pins carry only the stance now; evidence the pinner wants
// to attach lives in the typed-edge graph.
type PinInfo struct {
	Kind db.PinKind
}

// TopicView is one child view in a topic's thread feed.
type TopicView struct {
	ID                     uuid.UUID
	Slug                   string
	Title                  string
	Body                   string
	CreatedAt              pgtype.Timestamptz
	AuthorUsername         string
	AuthorProfileImagePath string
	CommentCount           int64
}

// Comment is one rendered comment or one reply. Replies are populated only
// for top-level comments; the server enforces a single reply level.
type Comment struct {
	ID                     uuid.UUID
	AuthorID               uuid.UUID
	AuthorUsername         string
	AuthorProfileImagePath string
	Body                   string
	CreatedAt              pgtype.Timestamptz
	EditedAt               pgtype.Timestamptz
	DeletedAt              pgtype.Timestamptz
	CanEdit                bool
	CanDelete              bool
	Replies                []Comment
}

// pinKindLabel turns a PinKind value into the verb shown in the UI banner
// ("You support this", "You oppose this", "On your profile").
func pinKindLabel(k db.PinKind) string {
	switch k {
	case db.PinKindSupports:
		return "You support this"
	case db.PinKindOpposes:
		return "You oppose this"
	case db.PinKindFeatured:
		return "On your profile"
	}
	return string(k)
}

// pinBannerClass adds a kind-specific modifier so CSS can color the banner
// (green for supports, red for opposes, neutral for featured).
func pinBannerClass(k db.PinKind) string {
	return "pin-banner pin-" + string(k)
}

// cascadeEdgeLabel renders the edge-count line on the deletion confirmation
// page. Pluralized so "1 connection" reads naturally next to the larger plural.
func cascadeEdgeLabel(n int64) string {
	if n == 1 {
		return "1 connection"
	}
	return fmt.Sprintf("%d connections", n)
}

// cascadePinLabel renders the other-users'-pins line. None at all gets a
// distinct phrasing — "0 pins from other users" reads worse than "No other
// users have pinned this."
func cascadePinLabel(n int64) string {
	if n == 0 {
		return "No other users have pinned this node."
	}
	if n == 1 {
		return "1 other user's pin to this node will be removed."
	}
	return fmt.Sprintf("%d other users' pins to this node will be removed.", n)
}

func commentCountLabel(n int64) string {
	if n == 1 {
		return "1 comment"
	}
	return fmt.Sprintf("%d comments", n)
}

func relativeTime(t time.Time) string {
	d := time.Since(t)
	if d < 0 {
		return "just now"
	}
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	case d < 30*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	case d < 365*24*time.Hour:
		return fmt.Sprintf("%dmo ago", int(d.Hours()/(24*30)))
	default:
		return fmt.Sprintf("%dy ago", int(d.Hours()/(24*365)))
	}
}

func timestampDatetime(ts pgtype.Timestamptz) string {
	if !ts.Valid {
		return ""
	}
	return ts.Time.Format(time.RFC3339)
}

func timestampTitle(v *Viewer, ts pgtype.Timestamptz) string {
	if !ts.Valid {
		return ""
	}
	return ts.Time.In(v.Location()).Format("Jan 2, 2006 15:04")
}

func timestampRelative(ts pgtype.Timestamptz) string {
	if !ts.Valid {
		return ""
	}
	return relativeTime(ts.Time)
}

func topicViewExcerpt(body string) string {
	plain := strings.Join(strings.Fields(body), " ")
	if plain == "" {
		return ""
	}
	r := []rune(plain)
	if len(r) <= 180 {
		return plain
	}
	return string(r[:180]) + "..."
}

// nodeTypeChip renders a chip with the node-type pastel.
templ nodeTypeChip(t db.NodeType) {
	<span class={ "chip", string(t) }>
		<span class="dot"></span>
		{ string(t) }
	</span>
}

templ NodeDetail(viewer *Viewer, node db.Node, authorUsername string, featured []FeaturedRow, groups []EdgeGroup, topicViews []TopicView, comments []Comment, commentCount int64, pin *PinInfo, tags []db.Tag, canEdit, canLink, canDelete bool) {
	@Layout(node.Title, viewer) {
		<div class="page medium">
			<article class="node card" style="padding: 36px;">
				<header class="node-header">
					<h1 style="margin: 0; min-width: 0;">{ node.Title }</h1>
					@nodeTypeChip(node.Type)
				</header>
				<a href={ templ.SafeURL("/users/" + authorUsername) } class="node-author" style="margin-top: 8px;">
					@Avatar(authorUsername, 20)
					{ authorUsername }
				</a>
				if nodeMarkdownHasText(node.Body) {
					<section class="body markdown-body" style="margin-top: 14px;">
						@NodeMarkdown(node.Body)
					</section>
				}
				if node.SourceUrl != nil && *node.SourceUrl != "" {
					<section class="source" style="margin-top: 14px;">
						<a href={ templ.SafeURL(*node.SourceUrl) } target="_blank" rel="noopener">↗ { *node.SourceUrl }</a>
					</section>
				}
				if len(tags) > 0 {
					<section class="node-tags" style="margin-top: 18px;">
						for _, t := range tags {
							<a href={ templ.SafeURL("/tags/" + t.Name) } class="tag">#{ t.Name }</a>
						}
					</section>
				}
				if viewer != nil {
					<div class="node-actions" style="margin-top: 22px;">
						if canLink {
							<a
								href={ templ.SafeURL("/nodes/" + node.Slug + "/edges/new") }
								class="btn"
								hx-get={ "/nodes/" + node.Slug + "/edges/new" }
								hx-target="#modal"
								hx-swap="innerHTML"
							><span class="material-symbols-outlined">conversion_path</span>Connect</a>
						}
						if canEdit {
							<a href={ templ.SafeURL("/nodes/" + node.Slug + "/edit") } class="btn ghost"><span class="material-symbols-outlined">edit</span>Edit</a>
						}
						<a href={ templ.SafeURL("/nodes/" + node.Slug + "/history") } class="btn ghost"><span class="material-symbols-outlined">history</span>History</a>
						if pin == nil {
							<a
								href={ templ.SafeURL("/nodes/" + node.Slug + "/pin") }
								class="btn accent"
								hx-get={ "/nodes/" + node.Slug + "/pin" }
								hx-target="#modal"
								hx-swap="innerHTML"
							><span class="material-symbols-outlined">graphic_eq</span>Resonate</a>
						}
						if canDelete {
							<a href={ templ.SafeURL("/nodes/" + node.Slug + "/delete") } class="btn danger"><span class="material-symbols-outlined">delete</span>Delete</a>
						}
					</div>
				}
				if viewer != nil && pin != nil {
					<div class={ pinBannerClass(pin.Kind) } style="margin-top: 18px;">
						<strong>{ pinKindLabel(pin.Kind) }.</strong>
						<a
							href={ templ.SafeURL("/nodes/" + node.Slug + "/pin") }
							class="muted"
							style="margin-left: auto; font-size: 13px; display: inline-flex; align-items: center; gap: 4px;"
							hx-get={ "/nodes/" + node.Slug + "/pin" }
							hx-target="#modal"
							hx-swap="innerHTML"
						><span class="material-symbols-outlined" style="font-size: 14px;">edit</span>Change</a>
						<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/unpin") } class="inline">
							@CSRFField()
							<button type="submit" class="link" style="display: inline-flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 14px;">keep_off</span>Remove</button>
						</form>
					</div>
				}
			</article>

			if node.Type == db.NodeTypeTopic {
				@TopicViewFeed(viewer, topicViews)
			}

			if len(featured) > 0 {
				<section class="featured">
					<h2>Key findings</h2>
					for _, f := range featured {
						<article class={ "featured-card", "edge-" + string(f.Kind) }>
							<header class="featured-head">
								<span class="kind-label">{ f.Label }</span>
								@nodeTypeChip(f.Type)
								<span class="grow"></span>
							</header>
							<h3><a href={ templ.SafeURL("/nodes/" + f.Slug) }>{ f.Title }</a></h3>
							if nodeMarkdownHasText(f.Body) {
								<div class="markdown-body featured-markdown">
									@NodeMarkdown(f.Body)
								</div>
							}
							if canEdit {
								<div class="row gap-8 wrap" style="margin-top: 12px;">
									<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + f.EdgeID.String() + "/unhighlight") } class="inline">
										@CSRFField()
										<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">star</span>Unhighlight</button>
									</form>
									<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + f.EdgeID.String() + "/delete") } class="inline">
										@CSRFField()
										<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">conversion_path_off</span>Disconnect</button>
									</form>
								</div>
							}
						</article>
					}
				</section>
			}

			<aside class="legend">
				<h2>Connections</h2>
				if len(groups) == 0 {
					<p class="muted">No connections yet.</p>
				} else {
					for _, g := range groups {
						<div class={ "edge-group", "edge-" + string(g.Kind) }>
							<h4>{ g.Label }</h4>
							<ul>
								for _, r := range g.Rows {
									<li>
										<a href={ templ.SafeURL("/nodes/" + r.Slug) }>
											<span class="title">{ r.Title }</span>
											@nodeTypeChip(r.Type)
										</a>
										if canEdit {
											<div class="edge-actions">
												if r.Type == db.NodeTypeFinding {
													<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + r.EdgeID.String() + "/highlight") } class="inline">
														@CSRFField()
														<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">star_shine</span>Highlight</button>
													</form>
												}
												<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + r.EdgeID.String() + "/delete") } class="inline">
													@CSRFField()
													<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">conversion_path_off</span>Disconnect</button>
												</form>
											</div>
										}
									</li>
								}
							</ul>
						</div>
					}
				}
			</aside>
			if node.Type == db.NodeTypeView {
				@CommentSection(viewer, node, comments, commentCount)
			}
		</div>
	}
}

templ TopicViewFeed(viewer *Viewer, items []TopicView) {
	<section class="topic-feed">
		<div class="section-head">
			<div>
				<h2>Views</h2>
				<p class="muted">Posts anchored to this topic.</p>
			</div>
		</div>
		if len(items) == 0 {
			<div class="card muted topic-empty">No views in this topic yet.</div>
		} else {
			<div class="topic-view-list">
				for _, item := range items {
					<article class="topic-view-row">
						<header>
							<a href={ templ.SafeURL("/nodes/" + item.Slug) } class="topic-view-title">{ item.Title }</a>
							<span class="topic-view-comments">{ commentCountLabel(item.CommentCount) }</span>
						</header>
						<div class="topic-view-meta">
							<a href={ templ.SafeURL("/users/" + item.AuthorUsername) } class="node-author">
								@AvatarImage(item.AuthorUsername, item.AuthorProfileImagePath, 20)
								{ item.AuthorUsername }
							</a>
							<span>·</span>
							<time datetime={ timestampDatetime(item.CreatedAt) } title={ timestampTitle(viewer, item.CreatedAt) }>{ timestampRelative(item.CreatedAt) }</time>
						</div>
						if topicViewExcerpt(item.Body) != "" {
							<p>{ topicViewExcerpt(item.Body) }</p>
						}
					</article>
				}
			</div>
		}
	</section>
}

templ CommentSection(viewer *Viewer, node db.Node, comments []Comment, count int64) {
	<section id="comments" class="comments">
		<div class="comments-head">
			<h2>Comments</h2>
			<span class="muted">{ commentCountLabel(count) }</span>
		</div>
		if viewer != nil {
			@CommentForm(node, "", "Comment")
		} else {
			<p class="muted comment-login"><a href="/login">Sign in</a> to comment.</p>
		}
		if len(comments) == 0 {
			<p class="muted comments-empty">No comments yet.</p>
		} else {
			<ol class="comment-list">
				for _, c := range comments {
					@CommentItem(viewer, node, c, false)
				}
			</ol>
		}
	</section>
}

templ CommentForm(node db.Node, parentID string, buttonText string) {
	<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/comments") } class="comment-form">
		@CSRFField()
		if parentID != "" {
			<input type="hidden" name="parent_id" value={ parentID }/>
		}
		<textarea name="body" rows="3" maxlength="5000" required placeholder="Write a comment" aria-label="Comment"></textarea>
		<div class="form-row">
			<button type="submit" class="btn accent sm"><span class="material-symbols-outlined">chat</span>{ buttonText }</button>
		</div>
	</form>
}

templ CommentItem(viewer *Viewer, node db.Node, c Comment, isReply bool) {
	<li id={ "comment-" + c.ID.String() } class="comment-item">
		<article class="comment-card">
			<header class="comment-meta">
				@AvatarImage(c.AuthorUsername, c.AuthorProfileImagePath, 22)
				<a href={ templ.SafeURL("/users/" + c.AuthorUsername) }>{ c.AuthorUsername }</a>
				<span>·</span>
				<time datetime={ timestampDatetime(c.CreatedAt) } title={ timestampTitle(viewer, c.CreatedAt) }>{ timestampRelative(c.CreatedAt) }</time>
				if c.EditedAt.Valid && !c.DeletedAt.Valid {
					<span>·</span>
					<time datetime={ timestampDatetime(c.EditedAt) } title={ timestampTitle(viewer, c.EditedAt) }>edited { timestampRelative(c.EditedAt) }</time>
				}
			</header>
			if c.DeletedAt.Valid {
				<div class="comment-body comment-removed">comment removed</div>
			} else {
				<div class="comment-body">{ c.Body }</div>
			}
			if c.CanEdit || c.CanDelete || (viewer != nil && !isReply && !c.DeletedAt.Valid) {
				<div class="comment-actions">
					if viewer != nil && !isReply && !c.DeletedAt.Valid {
						<details class="comment-reply">
							<summary class="btn ghost sm"><span class="material-symbols-outlined">reply</span>Reply</summary>
							@CommentForm(node, c.ID.String(), "Reply")
						</details>
					}
					if c.CanEdit {
						<a href={ templ.SafeURL("/nodes/" + node.Slug + "/comments/" + c.ID.String() + "/edit") } class="btn ghost sm"><span class="material-symbols-outlined">edit</span>Edit</a>
					}
					if c.CanDelete {
						<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/comments/" + c.ID.String() + "/delete") } class="inline">
							@CSRFField()
							<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">delete</span>Delete</button>
						</form>
					}
				</div>
			}
		</article>
		if len(c.Replies) > 0 {
			<ol class="comment-replies">
				for _, reply := range c.Replies {
					@CommentItem(viewer, node, reply, true)
				}
			</ol>
		}
	</li>
}

templ CommentEdit(viewer *Viewer, node db.Node, comment Comment, flash, formBody string) {
	@Layout("Edit comment", viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Comment</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">Edit comment</h1>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/comments/" + comment.ID.String()) } class="form">
				@CSRFField()
				<label>
					Comment
					<textarea name="body" rows="6" maxlength="5000" required>{ formBody }</textarea>
				</label>
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">save</span>Save changes</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug + "#comment-" + comment.ID.String()) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

templ NodeEdit(viewer *Viewer, node db.Node, flash string, formTitle, formBody, formSourceURL, formTags, formVisibility string, groups []db.ListGroupsForUserRow, isAuthor, canChangeVisibility bool, formEditPolicy, formLinkPolicy string) {
	@Layout("Edit "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Edit</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 8px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">The node type cannot be changed after creation.</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug) } class="form">
				@CSRFField()
				<label>
					Title
					<input type="text" name="title" required maxlength="200" value={ formTitle }/>
				</label>
				<label>
					Body
					<textarea
						name="body"
						rows="6"
						class="markdown-editor"
						data-image-endpoint={ "/nodes/" + node.Slug + "/images" }
						data-video-endpoint={ "/nodes/" + node.Slug + "/videos" }
					>{ formBody }</textarea>
					<small>Optional. Describe the node in your own words. Drop or paste an image, or use the video button to attach a clip.</small>
				</label>
				if node.Type == db.NodeTypeFinding {
					<label>
						Source URL <small>(optional — link to the external evidence, if any)</small>
						<input type="url" name="source_url" value={ formSourceURL }/>
					</label>
				}
				<label>
					Tags <small>(comma-separated, optional)</small>
					<input type="text" name="tags" value={ formTags } placeholder="climate, energy, ethics"/>
				</label>
				if canChangeVisibility {
					@nodeVisibilitySelect(formVisibility, groups)
				}
				if isAuthor {
					@actionPolicySelect("edit_policy", "Who can edit this node", formEditPolicy)
					@actionPolicySelect("link_policy", "Who can connect to this node", formLinkPolicy)
				} else if canChangeVisibility {
					<p class="muted" style="font-size: 12px; margin: 0;">You're editing as staff. Visibility is adjustable; edit and link permissions remain author-only.</p>
				} else {
					<p class="muted" style="font-size: 12px; margin: 0;">Visibility and permissions can only be changed by the node's author.</p>
				}
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">save</span>Save changes</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// actionPolicySelect renders the three-level author/connections/public
// toggle for edit_policy and link_policy. fieldName is the form input
// name so one template renders both policies.
templ actionPolicySelect(fieldName, legend, selected string) {
	<fieldset class="toggle-group">
		<legend>{ legend }</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-policy="author">
				<input type="radio" name={ fieldName } value="author" checked?={ selected == "author" || selected == "" }/>
				<span class="material-symbols-outlined">person</span>
				Only me
			</label>
			<label class="toggle-btn" data-policy="connections">
				<input type="radio" name={ fieldName } value="connections" checked?={ selected == "connections" }/>
				<span class="material-symbols-outlined">handshake</span>
				Connections
			</label>
			<label class="toggle-btn" data-policy="public">
				<input type="radio" name={ fieldName } value="public" checked?={ selected == "public" }/>
				<span class="material-symbols-outlined">public</span>
				Anyone
			</label>
		</div>
	</fieldset>
}

// visibilitySelect renders the audience picker used in the account
// preferences form, where only the owner-independent kinds (public /
// connections / private) are valid defaults — group selection is per-
// node, not a default.
templ visibilitySelect(selected string) {
	<fieldset class="toggle-group">
		<legend>Default visibility</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-visibility="public">
				<input type="radio" name="visibility" value="public" checked?={ selected == "public" || selected == "" }/>
				<span class="material-symbols-outlined">public</span>
				Public
			</label>
			<label class="toggle-btn" data-visibility="connections">
				<input type="radio" name="visibility" value="connections" checked?={ selected == "connections" }/>
				<span class="material-symbols-outlined">handshake</span>
				Connections
			</label>
			<label class="toggle-btn" data-visibility="private">
				<input type="radio" name="visibility" value="private" checked?={ selected == "private" }/>
				<span class="material-symbols-outlined">lock</span>
				Private
			</label>
		</div>
	</fieldset>
}

// nodeVisibilitySelect renders the per-node audience picker as a
// toggle-button group. Values: "public", "connections", "group:<uuid>",
// "private". The "group:<uuid>" form keeps the field single while still
// identifying which group governs visibility.
templ nodeVisibilitySelect(selected string, groups []db.ListGroupsForUserRow) {
	<fieldset class="toggle-group">
		<legend>Visibility</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-visibility="public">
				<input type="radio" name="visibility" value="public" checked?={ selected == "public" || selected == "" }/>
				<span class="material-symbols-outlined">public</span>
				<span class="visibility-public-label">
					<span class="visibility-label-default">Public</span>
					<span class="visibility-label-hover" aria-hidden="true">Inherit</span>
				</span>
			</label>
			<label class="toggle-btn" data-visibility="connections">
				<input type="radio" name="visibility" value="connections" checked?={ selected == "connections" }/>
				<span class="material-symbols-outlined">handshake</span>
				Connections
			</label>
			for _, g := range groups {
				<label class="toggle-btn" data-visibility="group">
					<input type="radio" name="visibility" value={ "group:" + g.ID.String() } checked?={ selected == "group:"+g.ID.String() }/>
					<span class="material-symbols-outlined">groups</span>
					{ g.Name }
				</label>
			}
			<label class="toggle-btn" data-visibility="private">
				<input type="radio" name="visibility" value="private" checked?={ selected == "private" }/>
				<span class="material-symbols-outlined">lock</span>
				Private
			</label>
		</div>
		if len(groups) > 0 {
			<small class="muted" style="font-size: 12px;">Connections requires a mutual follow. Manage communities in <a href="/groups">Groups</a>.</small>
		} else {
			<small class="muted" style="font-size: 12px;">Connections requires a mutual follow.</small>
		}
	</fieldset>
}

templ PinForm(viewer *Viewer, node db.Node, flash, formKind string) {
	@Layout("Resonate · "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Resonate</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">
				if node.Type == db.NodeTypeView {
					Take a stance — support or oppose — or just feature it. Evidence and reasoning live in the graph; use Connect to add a finding.
				} else {
					Feature this on your profile.
				}
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/pin") } class="form">
				@pinFormFields(node, formKind)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">graphic_eq</span>Resonate</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// PinModal renders the same form inside a modal frame. Returned when
// GET /nodes/{slug}/pin arrives with HX-Request: true (the node page's
// Resonate button opens it in-place). Form submit posts via htmx; on
// validation error the server re-renders this fragment, on success the
// handler sets HX-Redirect so htmx does a full page navigation.
templ PinModal(node db.Node, flash, formKind string) {
	<div class="modal-backdrop" onclick="if(event.target===this)document.getElementById('modal').innerHTML=''">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="pin-modal-title">
			<button type="button" class="modal-close" aria-label="Close" onclick="document.getElementById('modal').innerHTML=''">
				<span class="material-symbols-outlined">close</span>
			</button>
			<div class="row gap-12 wrap center" style="margin-bottom: 10px;">
				<span class="eyebrow">Resonate</span>
				@nodeTypeChip(node.Type)
			</div>
			<h2 id="pin-modal-title" style="margin: 0 0 6px; font-size: 22px;">{ node.Title }</h2>
			<p class="muted" style="margin: 0 0 18px; font-size: 13px;">
				if node.Type == db.NodeTypeView {
					Take a stance — or just feature it.
				} else {
					Feature this on your profile.
				}
			</p>
			@Flash(flash)
			<form
				method="post"
				action={ templ.SafeURL("/nodes/" + node.Slug + "/pin") }
				class="form"
				hx-post={ "/nodes/" + node.Slug + "/pin" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@pinFormFields(node, formKind)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">graphic_eq</span>Resonate</button>
					<button type="button" class="btn ghost" onclick="document.getElementById('modal').innerHTML=''"><span class="material-symbols-outlined">close</span>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

// pinFormFields is the shared body of PinForm (standalone page) and
// PinModal (htmx modal). Views get support / oppose / feature; other
// node types only get feature.
templ pinFormFields(node db.Node, formKind string) {
	@CSRFField()
	<fieldset class="toggle-group">
		<legend>Stance</legend>
		<div class="toggle-btns">
			if node.Type == db.NodeTypeView {
				<label class="toggle-btn" data-kind="supports">
					<input type="radio" name="kind" value="supports" checked?={ formKind == "supports" || formKind == "" }/>
					<span class="material-symbols-outlined">heart_plus</span>
					Support
				</label>
				<label class="toggle-btn" data-kind="opposes">
					<input type="radio" name="kind" value="opposes" checked?={ formKind == "opposes" }/>
					<span class="material-symbols-outlined">heart_minus</span>
					Oppose
				</label>
			}
			<label class="toggle-btn" data-kind="featured">
				<input type="radio" name="kind" value="featured" checked?={ formKind == "featured" || (node.Type != db.NodeTypeView && formKind == "") }/>
				<span class="material-symbols-outlined">keep</span>
				Just feature
			</label>
		</div>
	</fieldset>
}

// TopicCandidate is a slim node row for the parent-node picker on the post
// form. Type drives the chip colour shown next to each candidate — for
// view / sub-topic flows it's always 'topic'; for the finding flow it can
// be any node type.
type TopicCandidate struct {
	ID    uuid.UUID
	Type  db.NodeType
	Title string
}

// TopicCandidatePicker renders the parent-node search results in the post
// form. Stable id="parent-picker-target" lets HTMX swap it on each live-
// search update. selectedID pre-checks the radio that matches — used when
// re-rendering on error.
templ TopicCandidatePicker(find, selectedID string, candidates []TopicCandidate) {
	<div id="parent-picker-target">
		if find == "" && len(candidates) == 0 {
			<p class="muted" style="font-size: 13px;">Search above to find a parent.</p>
		}
		if find != "" && len(candidates) == 0 {
			<p class="muted" style="font-size: 13px;">No nodes match that query.</p>
		}
		if len(candidates) > 0 {
			<fieldset class="form-fieldset candidate-list">
				<legend>Pick a parent</legend>
				for _, c := range candidates {
					<label class="radio">
						<input type="radio" name="parent_node_id" value={ c.ID.String() } checked?={ c.ID.String() == selectedID }/>
						@nodeTypeChip(c.Type)
						<span>{ c.Title }</span>
					</label>
				}
			</fieldset>
		}
	</div>
}

// EdgeCandidate is the slim row the edge-creation picker renders for each
// search hit: just enough to show a labelled radio button.
type EdgeCandidate struct {
	ID    uuid.UUID
	Type  db.NodeType
	Title string
}

templ EdgeNew(viewer *Viewer, fromNode db.Node, flash, formKind, formToMode, find, formNewFindingTitle string, candidates []EdgeCandidate) {
	@Layout("Add connection", viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Connect from</span>
				@nodeTypeChip(fromNode.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ fromNode.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">
				You are creating a directed connection <strong>from</strong> this node <strong>to</strong> another.
				The kind describes how the source relates to the target.
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + fromNode.Slug + "/edges") } class="form">
				@edgeFormFields(fromNode, formKind, formToMode, find, formNewFindingTitle, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">conversion_path</span>Add connection</button>
					<a href={ templ.SafeURL("/nodes/" + fromNode.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// EdgeNewModal renders the edge-creation form inside a modal frame. Returned
// when the GET hits /edges/new with HX-Request: true (Connect button opens it
// in-place). Form submit is htmx-driven against the same /edges POST; on
// validation error the server re-renders this fragment, on success it sets
// HX-Redirect so htmx does a full page navigation.
templ EdgeNewModal(fromNode db.Node, flash, formKind, formToMode, find, formNewFindingTitle string, candidates []EdgeCandidate) {
	<div class="modal-backdrop" onclick="if(event.target===this)document.getElementById('modal').innerHTML=''">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
			<button type="button" class="modal-close" aria-label="Close" onclick="document.getElementById('modal').innerHTML=''">
				<span class="material-symbols-outlined">close</span>
			</button>
			<div class="row gap-12 wrap center" style="margin-bottom: 10px;">
				<span class="eyebrow">Connect from</span>
				@nodeTypeChip(fromNode.Type)
			</div>
			<h2 id="modal-title" style="margin: 0 0 6px; font-size: 22px;">{ fromNode.Title }</h2>
			<p class="muted" style="margin: 0 0 18px; font-size: 13px;">
				Create a directed connection from this node to another.
			</p>
			@Flash(flash)
			<form
				method="post"
				action={ templ.SafeURL("/nodes/" + fromNode.Slug + "/edges") }
				class="form"
				hx-post={ "/nodes/" + fromNode.Slug + "/edges" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@edgeFormFields(fromNode, formKind, formToMode, find, formNewFindingTitle, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">conversion_path</span>Add connection</button>
					<button type="button" class="btn ghost" onclick="document.getElementById('modal').innerHTML=''"><span class="material-symbols-outlined">close</span>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

templ edgeFormFields(fromNode db.Node, formKind, formToMode, find, formNewFindingTitle string, candidates []EdgeCandidate) {
	@CSRFField()
	<fieldset class="toggle-group">
		<legend>Relationship kind</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-edge-kind="supports">
				<input type="radio" name="kind" value="supports" required checked?={ formKind == "supports" || formKind == "" }/>
				<span class="material-symbols-outlined">thumb_up</span>
				Supports
			</label>
			<label class="toggle-btn" data-edge-kind="opposes">
				<input type="radio" name="kind" value="opposes" checked?={ formKind == "opposes" }/>
				<span class="material-symbols-outlined">thumb_down</span>
				Opposes
			</label>
			<label class="toggle-btn" data-edge-kind="related">
				<input type="radio" name="kind" value="related" checked?={ formKind == "related" }/>
				<span class="material-symbols-outlined">link</span>
				Related
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">How the source relates to the target — supports backs it, opposes argues against, and related is for everything else (citations, clarifications, loose links).</small>
	</fieldset>
	<fieldset class="toggle-group edge-target-mode">
		<legend>Target</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-to-mode="existing">
				<input type="radio" name="to_mode" value="existing" checked?={ formToMode != "new" }/>
				<span class="material-symbols-outlined">search</span>
				Existing node
			</label>
			<label class="toggle-btn" data-to-mode="new">
				<input type="radio" name="to_mode" value="new" checked?={ formToMode == "new" }/>
				<span class="material-symbols-outlined">add_circle</span>
				New finding
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">Pick a node already in the graph, or create a new finding attached to this one. The new finding inherits visibility from this node.</small>
	</fieldset>
	<div class="edge-target-existing">
		<label>
			Find target node
			<input
				type="search"
				name="find"
				value={ find }
				placeholder="search by title or body…"
				hx-get={ "/nodes/" + fromNode.Slug + "/edges/picker" }
				hx-trigger="input changed delay:200ms, search"
				hx-target="#picker-target"
				hx-swap="outerHTML"
			/>
			<small>Results update as you type.</small>
		</label>
		@CandidatePicker(find, candidates)
	</div>
	<label class="edge-target-new">
		New finding title
		<input
			type="text"
			name="new_finding_title"
			value={ formNewFindingTitle }
			maxlength="200"
			placeholder="e.g. The 2023 IPCC synthesis report"
		/>
		<small>The finding is created with this title and attached by the chosen relationship kind.</small>
	</label>
}

templ NodeDelete(viewer *Viewer, node db.Node, edgeCount, otherPinCount int64) {
	@Layout("Delete "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Delete</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 12px;">This permanently removes the node. The action cannot be undone.</p>
			<ul class="muted" style="margin: 0 0 24px; padding-left: 20px; line-height: 1.7;">
				<li>{ cascadeEdgeLabel(edgeCount) } will be removed.</li>
				<li>{ cascadePinLabel(otherPinCount) }</li>
				<li>Tags lose their link to this node, but the tags themselves remain.</li>
			</ul>
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/delete") } class="form">
				@CSRFField()
				<div class="form-row">
					<button type="submit" class="btn danger"><span class="material-symbols-outlined">delete_forever</span>Yes, delete this node</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// CandidatePicker is rendered both on the full /edges/new page and as a
// fragment via HTMX live-search. The outer div has a stable id so HTMX can
// target it with hx-swap="outerHTML" — each fragment response replaces the
// previous one in place.
templ CandidatePicker(find string, candidates []EdgeCandidate) {
	<div id="picker-target">
		if find == "" {
			<p class="muted">Start typing in the search box above to see matching nodes.</p>
		}
		if find != "" && len(candidates) == 0 {
			<p class="muted">No nodes match that query.</p>
		}
		if find != "" && len(candidates) > 0 {
			<fieldset class="form-fieldset candidate-list">
				<legend>Pick a target</legend>
				for _, c := range candidates {
					<label class="radio">
						<input type="radio" name="to_id" value={ c.ID.String() } required/>
						@nodeTypeChip(c.Type)
						<span>{ c.Title }</span>
					</label>
				}
			</fieldset>
		}
	</div>
}
