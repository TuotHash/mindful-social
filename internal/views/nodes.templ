package views

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/TuotHash/mindful-social/internal/db"
)

// NodeNew renders the standalone Post form. Used as a fallback for direct
// URL hits and no-JS clients; the nav button opens NodeNewModal via htmx.
// Source URL is intentionally absent — only Topic and View are creatable
// from the Post path; findings are created by attachment to an existing
// topic or view.
templ NodeNew(viewer *Viewer, flash string, formType, formTitle, formBody, formPin, formTags, formVisibility string, lists []db.AudienceList, groups []db.ListGroupsForUserRow, findTopic, formParentTopicID, formTopicParentMode string, topicCandidates []TopicCandidate) {
	@Layout("Post", viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Post</span>
				<h1 class="h-1">New post</h1>
				<p class="muted" style="margin: 0;">A view is a stance — that's the standard post. A topic groups views together. Findings are added later as connections off an existing topic or view.</p>
			</div>
			@Flash(flash)
			<form method="post" action="/nodes" class="form post-form">
				@postFormFields(formType, formTitle, formBody, formPin, formTags, formVisibility, lists, groups, findTopic, formParentTopicID, formTopicParentMode, topicCandidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">send</span>Post</button>
					<a href="/home" class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// NodeNewModal renders the same Post form inside a modal frame. Returned
// when GET /nodes/new arrives with HX-Request: true. Form submit posts
// via htmx; on validation error the server re-renders this fragment, on
// success the handler returns HX-Redirect so htmx does a full navigation.
templ NodeNewModal(flash string, formType, formTitle, formBody, formPin, formTags, formVisibility string, lists []db.AudienceList, groups []db.ListGroupsForUserRow, findTopic, formParentTopicID, formTopicParentMode string, topicCandidates []TopicCandidate) {
	<div class="modal-backdrop" onclick="if(event.target===this)document.getElementById('modal').innerHTML=''">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="post-modal-title">
			<button type="button" class="modal-close" aria-label="Close" onclick="document.getElementById('modal').innerHTML=''">
				<span class="material-symbols-outlined">close</span>
			</button>
			<div class="row gap-12 wrap center" style="margin-bottom: 6px;">
				<span class="eyebrow">Post</span>
			</div>
			<h2 id="post-modal-title" style="margin: 0 0 6px; font-size: 22px;">New post</h2>
			<p class="muted" style="margin: 0 0 18px; font-size: 13px;">
				Share a view or start a topic. Findings are added later as connections.
			</p>
			@Flash(flash)
			<form
				method="post"
				action="/nodes"
				class="form post-form"
				hx-post="/nodes"
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@postFormFields(formType, formTitle, formBody, formPin, formTags, formVisibility, lists, groups, findTopic, formParentTopicID, formTopicParentMode, topicCandidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">send</span>Post</button>
					<button type="button" class="btn ghost" onclick="document.getElementById('modal').innerHTML=''"><span class="material-symbols-outlined">close</span>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

// postFormFields are the shared body of NodeNew and NodeNewModal. The outer
// .post-form class enables CSS :has() rules in app.css to hide
// view-specific options (Support / Oppose pin) when Topic is selected, the
// Position toggle when View is selected, and the topic picker when a root
// topic is being created.
templ postFormFields(formType, formTitle, formBody, formPin, formTags, formVisibility string, lists []db.AudienceList, groups []db.ListGroupsForUserRow, findTopic, formParentTopicID, formTopicParentMode string, topicCandidates []TopicCandidate) {
	@CSRFField()
	<fieldset class="toggle-group">
		<legend>Type</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-type="view">
				<input type="radio" name="type" value="view" required checked?={ formType == "view" || formType == "" }/>
				<span class="material-symbols-outlined">campaign</span>
				View
			</label>
			<label class="toggle-btn" data-type="topic">
				<input type="radio" name="type" value="topic" checked?={ formType == "topic" }/>
				<span class="material-symbols-outlined">workspaces</span>
				Topic
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">A view takes a stance. A topic groups views.</small>
	</fieldset>
	<fieldset class="toggle-group if-topic">
		<legend>Position</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-position="root">
				<input type="radio" name="topic_parent_mode" value="root" checked?={ formTopicParentMode != "sub" }/>
				<span class="material-symbols-outlined">flag</span>
				Root topic
			</label>
			<label class="toggle-btn" data-position="sub">
				<input type="radio" name="topic_parent_mode" value="sub" checked?={ formTopicParentMode == "sub" }/>
				<span class="material-symbols-outlined">subdirectory_arrow_right</span>
				Sub-topic
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">A root topic stands alone. A sub-topic anchors under another topic.</small>
	</fieldset>
	<label>
		Title
		<input type="text" name="title" required maxlength="200" value={ formTitle } autofocus/>
	</label>
	<label>
		Body
		<textarea
			name="body"
			rows="5"
			class="markdown-editor"
			data-image-endpoint-template="/nodes/{id}/images"
			data-image-endpoint-source="parent_topic_id"
			data-video-endpoint-template="/nodes/{id}/videos"
			data-video-endpoint-source="parent_topic_id"
		>{ formBody }</textarea>
		<small>Optional. Describe the node in your own words. Drop or paste an image, or use the video button to attach a clip.</small>
	</label>
	@nodeVisibilitySelect(formVisibility, lists, groups)
	<fieldset class="toggle-group">
		<legend>Pin to my profile</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-kind="none">
				<input type="radio" name="pin" value="" checked?={ formPin == "" }/>
				<span class="material-symbols-outlined">keep_off</span>
				Don't pin
			</label>
			<label class="toggle-btn" data-kind="featured">
				<input type="radio" name="pin" value="featured" checked?={ formPin == "featured" }/>
				<span class="material-symbols-outlined">keep</span>
				Feature
			</label>
			<label class="toggle-btn if-view" data-kind="supports">
				<input type="radio" name="pin" value="supports" checked?={ formPin == "supports" }/>
				<span class="material-symbols-outlined">heart_plus</span>
				Support
			</label>
			<label class="toggle-btn if-view" data-kind="opposes">
				<input type="radio" name="pin" value="opposes" checked?={ formPin == "opposes" }/>
				<span class="material-symbols-outlined">heart_minus</span>
				Oppose
			</label>
		</div>
	</fieldset>
	<label>
		Tags <small>(comma-separated, optional)</small>
		<input type="text" name="tags" value={ formTags } placeholder="climate, energy, ethics"/>
	</label>
	<div class="topic-picker-section">
		<label>
			Parent topic <span style="color: var(--opposes);">*</span>
			<input
				type="search"
				name="find_topic"
				value={ findTopic }
				placeholder="search topics…"
				autocomplete="off"
				hx-get="/nodes/topic-picker"
				hx-trigger="input changed delay:200ms, search"
				hx-target="#topic-picker-target"
				hx-swap="outerHTML"
				hx-include="[name='find_topic']"
			/>
			<small>Pick the topic this anchors under.</small>
		</label>
		@TopicCandidatePicker(findTopic, formParentTopicID, topicCandidates)
	</div>
}

// EdgeRow is one entry in a legend section. Outgoing is true when this row
// represents an edge that *originates* at the current node; false when the
// current node is the destination. Both directions can be highlighted, so
// this flag is informational rather than gating any button.
type EdgeRow struct {
	EdgeID   uuid.UUID
	Kind     db.EdgeKind
	Outgoing bool
	ID       uuid.UUID
	Slug     string
	Type     db.NodeType
	Title    string
}

// EdgeGroup is one section of the legend: a heading ("Supports", "Supported
// by", "Relates to", …) and the rows that fall under it.
type EdgeGroup struct {
	Label string
	Kind  db.EdgeKind
	Rows  []EdgeRow
}

// FeaturedRow is one card in the "Key findings" section, where the
// destination node's body is rendered inline rather than just linked.
type FeaturedRow struct {
	EdgeID uuid.UUID
	Kind   db.EdgeKind
	Label  string // human-readable kind, e.g. "Supports"
	ID     uuid.UUID
	Slug   string
	Type   db.NodeType
	Title  string
	Body   string
}

// PinInfo is non-nil when the current viewer has pinned the node being
// rendered. Findings is empty when the pin has no attached finding.
type PinInfo struct {
	Kind     db.PinKind
	Findings []PinFinding
}

// PinFinding is one finding node attached to a pin, in the shape the
// banner and profile list need to render a link.
type PinFinding struct {
	ID    uuid.UUID
	Slug  string
	Title string
}

// pinKindLabel turns a PinKind value into the verb shown in the UI banner
// ("You support this", "You oppose this", "On your profile").
func pinKindLabel(k db.PinKind) string {
	switch k {
	case db.PinKindSupports:
		return "You support this"
	case db.PinKindOpposes:
		return "You oppose this"
	case db.PinKindFeatured:
		return "On your profile"
	}
	return string(k)
}

// pinBannerClass adds a kind-specific modifier so CSS can color the banner
// (green for supports, red for opposes, neutral for featured).
func pinBannerClass(k db.PinKind) string {
	return "pin-banner pin-" + string(k)
}

// cascadeEdgeLabel renders the edge-count line on the deletion confirmation
// page. Pluralized so "1 connection" reads naturally next to the larger plural.
func cascadeEdgeLabel(n int64) string {
	if n == 1 {
		return "1 connection"
	}
	return fmt.Sprintf("%d connections", n)
}

// cascadePinLabel renders the other-users'-pins line. None at all gets a
// distinct phrasing — "0 pins from other users" reads worse than "No other
// users have pinned this."
func cascadePinLabel(n int64) string {
	if n == 0 {
		return "No other users have pinned this node."
	}
	if n == 1 {
		return "1 other user's pin to this node will be removed."
	}
	return fmt.Sprintf("%d other users' pins to this node will be removed.", n)
}

// nodeTypeChip renders a chip with the node-type pastel.
templ nodeTypeChip(t db.NodeType) {
	<span class={ "chip", string(t) }>
		<span class="dot"></span>
		{ string(t) }
	</span>
}

templ NodeDetail(viewer *Viewer, node db.Node, featured []FeaturedRow, groups []EdgeGroup, pin *PinInfo, tags []db.Tag, canEdit, canLink, canDelete bool) {
	@Layout(node.Title, viewer) {
		<div class="page medium">
			<article class="node card" style="padding: 36px;">
				<header class="node-header">
					<h1 style="margin: 0; min-width: 0;">{ node.Title }</h1>
					@nodeTypeChip(node.Type)
				</header>
				if nodeMarkdownHasText(node.Body) {
					<section class="body markdown-body" style="margin-top: 14px;">
						@NodeMarkdown(node.Body)
					</section>
				}
				if node.SourceUrl != nil && *node.SourceUrl != "" {
					<section class="source" style="margin-top: 14px;">
						<a href={ templ.SafeURL(*node.SourceUrl) } target="_blank" rel="noopener">↗ { *node.SourceUrl }</a>
					</section>
				}
				if len(tags) > 0 {
					<section class="node-tags" style="margin-top: 18px;">
						for _, t := range tags {
							<a href={ templ.SafeURL("/tags/" + t.Name) } class="tag">#{ t.Name }</a>
						}
					</section>
				}
				if viewer != nil {
					<div class="node-actions" style="margin-top: 22px;">
						if canLink {
							<a
								href={ templ.SafeURL("/nodes/" + node.Slug + "/edges/new") }
								class="btn"
								hx-get={ "/nodes/" + node.Slug + "/edges/new" }
								hx-target="#modal"
								hx-swap="innerHTML"
							><span class="material-symbols-outlined">conversion_path</span>Connect</a>
						}
						if canEdit {
							<a href={ templ.SafeURL("/nodes/" + node.Slug + "/edit") } class="btn ghost"><span class="material-symbols-outlined">edit</span>Edit</a>
						}
						if pin == nil {
							<a
								href={ templ.SafeURL("/nodes/" + node.Slug + "/pin") }
								class="btn accent"
								hx-get={ "/nodes/" + node.Slug + "/pin" }
								hx-target="#modal"
								hx-swap="innerHTML"
							><span class="material-symbols-outlined">graphic_eq</span>Resonate</a>
						}
						if canDelete {
							<a href={ templ.SafeURL("/nodes/" + node.Slug + "/delete") } class="btn danger"><span class="material-symbols-outlined">delete</span>Delete</a>
						}
					</div>
				}
				if viewer != nil && pin != nil {
					<div class={ pinBannerClass(pin.Kind) } style="margin-top: 18px;">
						<strong>{ pinKindLabel(pin.Kind) }.</strong>
						if len(pin.Findings) > 0 {
							via
							for i, f := range pin.Findings {
								if i > 0 {
									{ ", " }
								}
								<a href={ templ.SafeURL("/nodes/" + f.Slug) }>{ f.Title }</a>
							}
						}
						<a
							href={ templ.SafeURL("/nodes/" + node.Slug + "/pin") }
							class="muted"
							style="margin-left: auto; font-size: 13px; display: inline-flex; align-items: center; gap: 4px;"
							hx-get={ "/nodes/" + node.Slug + "/pin" }
							hx-target="#modal"
							hx-swap="innerHTML"
						><span class="material-symbols-outlined" style="font-size: 14px;">edit</span>Change</a>
						<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/unpin") } class="inline">
							@CSRFField()
							<button type="submit" class="link" style="display: inline-flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 14px;">keep_off</span>Remove</button>
						</form>
					</div>
				}
			</article>

			if len(featured) > 0 {
				<section class="featured">
					<h2>Key findings</h2>
					for _, f := range featured {
						<article class={ "featured-card", "edge-" + string(f.Kind) }>
							<header class="featured-head">
								<span class="kind-label">{ f.Label }</span>
								@nodeTypeChip(f.Type)
								<span class="grow"></span>
							</header>
							<h3><a href={ templ.SafeURL("/nodes/" + f.Slug) }>{ f.Title }</a></h3>
							if nodeMarkdownHasText(f.Body) {
								<div class="markdown-body featured-markdown">
									@NodeMarkdown(f.Body)
								</div>
							}
							if canEdit {
								<div class="row gap-8 wrap" style="margin-top: 12px;">
									<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + f.EdgeID.String() + "/unhighlight") } class="inline">
										@CSRFField()
										<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">star</span>Unhighlight</button>
									</form>
									<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + f.EdgeID.String() + "/delete") } class="inline">
										@CSRFField()
										<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">conversion_path_off</span>Disconnect</button>
									</form>
								</div>
							}
						</article>
					}
				</section>
			}

			<aside class="legend">
				<h2>Connections</h2>
				if len(groups) == 0 {
					<p class="muted">No connections yet.</p>
				} else {
					for _, g := range groups {
						<div class={ "edge-group", "edge-" + string(g.Kind) }>
							<h4>{ g.Label }</h4>
							<ul>
								for _, r := range g.Rows {
									<li>
										<a href={ templ.SafeURL("/nodes/" + r.Slug) }>
											<span class="title">{ r.Title }</span>
											@nodeTypeChip(r.Type)
										</a>
										if canEdit {
											<div class="edge-actions">
												if r.Type == db.NodeTypeFinding {
													<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + r.EdgeID.String() + "/highlight") } class="inline">
														@CSRFField()
														<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">star_shine</span>Highlight</button>
													</form>
												}
												<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/edges/" + r.EdgeID.String() + "/delete") } class="inline">
													@CSRFField()
													<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">conversion_path_off</span>Disconnect</button>
												</form>
											</div>
										}
									</li>
								}
							</ul>
						</div>
					}
				}
			</aside>
		</div>
	}
}

templ NodeEdit(viewer *Viewer, node db.Node, flash string, formTitle, formBody, formSourceURL, formTags, formVisibility string, lists []db.AudienceList, groups []db.ListGroupsForUserRow, isAuthor bool, formEditPolicy, formLinkPolicy string) {
	@Layout("Edit "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Edit</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 8px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">The node type cannot be changed after creation.</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug) } class="form">
				@CSRFField()
				<label>
					Title
					<input type="text" name="title" required maxlength="200" value={ formTitle }/>
				</label>
				<label>
					Body
					<textarea
						name="body"
						rows="6"
						class="markdown-editor"
						data-image-endpoint={ "/nodes/" + node.Slug + "/images" }
						data-video-endpoint={ "/nodes/" + node.Slug + "/videos" }
					>{ formBody }</textarea>
					<small>Optional. Describe the node in your own words. Drop or paste an image, or use the video button to attach a clip.</small>
				</label>
				if node.Type == db.NodeTypeFinding {
					<label>
						Source URL <small>(optional — link to the external evidence, if any)</small>
						<input type="url" name="source_url" value={ formSourceURL }/>
					</label>
				}
				<label>
					Tags <small>(comma-separated, optional)</small>
					<input type="text" name="tags" value={ formTags } placeholder="climate, energy, ethics"/>
				</label>
				if isAuthor {
					@nodeVisibilitySelect(formVisibility, lists, groups)
					@actionPolicySelect("edit_policy", "Who can edit this node", formEditPolicy)
					@actionPolicySelect("link_policy", "Who can connect to this node", formLinkPolicy)
				} else {
					<p class="muted" style="font-size: 12px; margin: 0;">Visibility and permissions can only be changed by the node's author.</p>
				}
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">save</span>Save changes</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// actionPolicySelect renders the three-level author/connections/public
// toggle for edit_policy and link_policy. fieldName is the form input
// name so one template renders both policies.
templ actionPolicySelect(fieldName, legend, selected string) {
	<fieldset class="toggle-group">
		<legend>{ legend }</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-policy="author">
				<input type="radio" name={ fieldName } value="author" checked?={ selected == "author" || selected == "" }/>
				<span class="material-symbols-outlined">person</span>
				Only me
			</label>
			<label class="toggle-btn" data-policy="connections">
				<input type="radio" name={ fieldName } value="connections" checked?={ selected == "connections" }/>
				<span class="material-symbols-outlined">handshake</span>
				Connections
			</label>
			<label class="toggle-btn" data-policy="public">
				<input type="radio" name={ fieldName } value="public" checked?={ selected == "public" }/>
				<span class="material-symbols-outlined">public</span>
				Anyone
			</label>
		</div>
	</fieldset>
}

// visibilitySelect renders the per-node audience picker as a toggle-button
// group. Values: "public", "connections", "list:<uuid>", "private". The
// "list:<uuid>" format keeps the form a single field while still
// identifying which list governs visibility.
templ visibilitySelect(selected string, lists []db.AudienceList) {
	@nodeVisibilitySelect(selected, lists, nil)
}

templ nodeVisibilitySelect(selected string, lists []db.AudienceList, groups []db.ListGroupsForUserRow) {
	<fieldset class="toggle-group">
		<legend>Visibility</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-visibility="public">
				<input type="radio" name="visibility" value="public" checked?={ selected == "public" || selected == "" }/>
				<span class="material-symbols-outlined">public</span>
				<span class="visibility-public-label">
					<span class="visibility-label-default">Public</span>
					<span class="visibility-label-hover" aria-hidden="true">Inherit</span>
				</span>
			</label>
			<label class="toggle-btn" data-visibility="connections">
				<input type="radio" name="visibility" value="connections" checked?={ selected == "connections" }/>
				<span class="material-symbols-outlined">handshake</span>
				Connections
			</label>
			for _, l := range lists {
				<label class="toggle-btn" data-visibility="list">
					<input type="radio" name="visibility" value={ "list:" + l.ID.String() } checked?={ selected == "list:"+l.ID.String() }/>
					if l.IsTrusted {
						<span class="material-symbols-outlined">verified_user</span>
						Trusted
					} else {
						<span class="material-symbols-outlined">groups</span>
						{ l.Name }
					}
				</label>
			}
			for _, g := range groups {
				<label class="toggle-btn" data-visibility="group">
					<input type="radio" name="visibility" value={ "group:" + g.ID.String() } checked?={ selected == "group:"+g.ID.String() }/>
					<span class="material-symbols-outlined">groups</span>
					{ g.Name }
				</label>
			}
			<label class="toggle-btn" data-visibility="private">
				<input type="radio" name="visibility" value="private" checked?={ selected == "private" }/>
				<span class="material-symbols-outlined">lock</span>
				Private
			</label>
		</div>
		if len(groups) > 0 {
			<small class="muted" style="font-size: 12px;">Connections requires a mutual follow. Manage lists in <a href="/lists">Lists</a>; manage communities in <a href="/groups">Groups</a>.</small>
		} else {
			<small class="muted" style="font-size: 12px;">Connections requires a mutual follow. Manage lists in <a href="/lists">Lists</a>.</small>
		}
	</fieldset>
}

// FindingCandidate is one finding node row rendered as a checkbox toggle
// in the pin form's finding picker.
type FindingCandidate struct {
	ID    uuid.UUID
	Slug  string
	Title string
}

templ PinForm(viewer *Viewer, node db.Node, flash, formKind, findFinding string, selectedFindingIDs []string, attached []PinFinding, candidates []FindingCandidate) {
	@Layout("Resonate · "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Resonate</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">
				if node.Type == db.NodeTypeView {
					Take a stance — support or oppose — or just feature it. Optionally attach findings that explain your thinking.
				} else {
					Feature this on your profile.
				}
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/pin") } class="form">
				@pinFormFields(node, formKind, findFinding, selectedFindingIDs, attached, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">graphic_eq</span>Resonate</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// PinModal renders the same form inside a modal frame. Returned when
// GET /nodes/{slug}/pin arrives with HX-Request: true (the node page's
// Resonate button opens it in-place). Form submit posts via htmx; on
// validation error the server re-renders this fragment, on success the
// handler sets HX-Redirect so htmx does a full page navigation.
templ PinModal(node db.Node, flash, formKind, findFinding string, selectedFindingIDs []string, attached []PinFinding, candidates []FindingCandidate) {
	<div class="modal-backdrop" onclick="if(event.target===this)document.getElementById('modal').innerHTML=''">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="pin-modal-title">
			<button type="button" class="modal-close" aria-label="Close" onclick="document.getElementById('modal').innerHTML=''">
				<span class="material-symbols-outlined">close</span>
			</button>
			<div class="row gap-12 wrap center" style="margin-bottom: 10px;">
				<span class="eyebrow">Resonate</span>
				@nodeTypeChip(node.Type)
			</div>
			<h2 id="pin-modal-title" style="margin: 0 0 6px; font-size: 22px;">{ node.Title }</h2>
			<p class="muted" style="margin: 0 0 18px; font-size: 13px;">
				if node.Type == db.NodeTypeView {
					Take a stance — or just feature it. Optionally attach findings.
				} else {
					Feature this on your profile.
				}
			</p>
			@Flash(flash)
			<form
				method="post"
				action={ templ.SafeURL("/nodes/" + node.Slug + "/pin") }
				class="form"
				hx-post={ "/nodes/" + node.Slug + "/pin" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@pinFormFields(node, formKind, findFinding, selectedFindingIDs, attached, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">graphic_eq</span>Resonate</button>
					<button type="button" class="btn ghost" onclick="document.getElementById('modal').innerHTML=''"><span class="material-symbols-outlined">close</span>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

// pinFormFields is the shared body of PinForm (standalone page) and
// PinModal (htmx modal). For views it offers support / oppose / feature
// plus a finding picker; for other node types only "feature" applies.
templ pinFormFields(node db.Node, formKind, findFinding string, selectedFindingIDs []string, attached []PinFinding, candidates []FindingCandidate) {
	@CSRFField()
	<fieldset class="toggle-group">
		<legend>Stance</legend>
		<div class="toggle-btns">
			if node.Type == db.NodeTypeView {
				<label class="toggle-btn" data-kind="supports">
					<input type="radio" name="kind" value="supports" checked?={ formKind == "supports" || formKind == "" }/>
					<span class="material-symbols-outlined">heart_plus</span>
					Support
				</label>
				<label class="toggle-btn" data-kind="opposes">
					<input type="radio" name="kind" value="opposes" checked?={ formKind == "opposes" }/>
					<span class="material-symbols-outlined">heart_minus</span>
					Oppose
				</label>
			}
			<label class="toggle-btn" data-kind="featured">
				<input type="radio" name="kind" value="featured" checked?={ formKind == "featured" || (node.Type != db.NodeTypeView && formKind == "") }/>
				<span class="material-symbols-outlined">keep</span>
				Just feature
			</label>
		</div>
	</fieldset>
	if node.Type == db.NodeTypeView {
		<fieldset class="toggle-group">
			<legend>Findings <small>(optional, multiple allowed)</small></legend>
			if len(attached) > 0 {
				<div class="toggle-btns toggle-btns-stack">
					for _, a := range attached {
						<label class="toggle-btn" data-finding="attached">
							<input type="checkbox" name="finding_ids" value={ a.ID.String() } checked/>
							<span class="material-symbols-outlined">psychology</span>
							{ a.Title }
						</label>
					}
				</div>
				<small class="muted" style="font-size: 12px;">Currently attached. Untick to remove.</small>
			}
			<label>
				Find more findings to attach
				<input
					type="search"
					name="find_finding"
					value={ findFinding }
					placeholder="search finding titles…"
					autocomplete="off"
					hx-get={ "/nodes/" + node.Slug + "/finding-picker" }
					hx-trigger="input changed delay:200ms, search"
					hx-target="#finding-picker-target"
					hx-swap="outerHTML"
					hx-include="[name='find_finding'],[name='finding_ids']"
				/>
			</label>
			@FindingCandidatePicker(findFinding, selectedFindingIDs, attached, candidates)
		</fieldset>
	}
}

// FindingCandidatePicker renders the finding search results. Stable id
// lets HTMX swap it on each keystroke. Findings already attached to the
// pin (or selected in this form session) are filtered out so the picker
// only shows new options to add.
templ FindingCandidatePicker(find string, selectedIDs []string, attached []PinFinding, candidates []FindingCandidate) {
	<div id="finding-picker-target">
		{{
			exclude := map[string]struct{}{}
			for _, a := range attached {
				exclude[a.ID.String()] = struct{}{}
			}
			for _, id := range selectedIDs {
				exclude[id] = struct{}{}
			}
			visible := make([]FindingCandidate, 0, len(candidates))
			for _, c := range candidates {
				if _, hit := exclude[c.ID.String()]; !hit {
					visible = append(visible, c)
				}
			}
		}}
		if find == "" && len(visible) == 0 {
			<p class="muted" style="font-size: 13px;">No more findings to attach. Start typing to search.</p>
		}
		if find != "" && len(visible) == 0 {
			<p class="muted" style="font-size: 13px;">No findings match that query.</p>
		}
		if len(visible) > 0 {
			<div class="toggle-btns toggle-btns-stack">
				for _, c := range visible {
					<label class="toggle-btn" data-finding="candidate">
						<input type="checkbox" name="finding_ids" value={ c.ID.String() }/>
						<span class="material-symbols-outlined">psychology</span>
						{ c.Title }
					</label>
				}
			</div>
		}
	</div>
}

// TopicCandidate is a slim topic row for the parent-topic picker on the post form.
type TopicCandidate struct {
	ID    uuid.UUID
	Title string
}

// TopicCandidatePicker renders the topic search results in the post form.
// Stable id="topic-picker-target" lets HTMX swap it on each live-search update.
// selectedID pre-checks the radio that matches — used when re-rendering on error.
templ TopicCandidatePicker(find, selectedID string, candidates []TopicCandidate) {
	<div id="topic-picker-target">
		if find == "" && len(candidates) == 0 {
			<p class="muted" style="font-size: 13px;">Search above to find a topic.</p>
		}
		if find != "" && len(candidates) == 0 {
			<p class="muted" style="font-size: 13px;">No topics match that query.</p>
		}
		if len(candidates) > 0 {
			<fieldset class="form-fieldset candidate-list">
				<legend>Pick a topic</legend>
				for _, c := range candidates {
					<label class="radio">
						<input type="radio" name="parent_topic_id" value={ c.ID.String() } checked?={ c.ID.String() == selectedID }/>
						@nodeTypeChip(db.NodeTypeTopic)
						<span>{ c.Title }</span>
					</label>
				}
			</fieldset>
		}
	</div>
}

// EdgeCandidate is the slim row the edge-creation picker renders for each
// search hit: just enough to show a labelled radio button.
type EdgeCandidate struct {
	ID    uuid.UUID
	Type  db.NodeType
	Title string
}

templ EdgeNew(viewer *Viewer, fromNode db.Node, flash, formKind, find string, candidates []EdgeCandidate) {
	@Layout("Add connection", viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Connect from</span>
				@nodeTypeChip(fromNode.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ fromNode.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">
				You are creating a directed connection <strong>from</strong> this node <strong>to</strong> another.
				The kind describes how the source relates to the target.
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + fromNode.Slug + "/edges") } class="form">
				@edgeFormFields(fromNode, formKind, find, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">conversion_path</span>Add connection</button>
					<a href={ templ.SafeURL("/nodes/" + fromNode.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// EdgeNewModal renders the edge-creation form inside a modal frame. Returned
// when the GET hits /edges/new with HX-Request: true (Connect button opens it
// in-place). Form submit is htmx-driven against the same /edges POST; on
// validation error the server re-renders this fragment, on success it sets
// HX-Redirect so htmx does a full page navigation.
templ EdgeNewModal(fromNode db.Node, flash, formKind, find string, candidates []EdgeCandidate) {
	<div class="modal-backdrop" onclick="if(event.target===this)document.getElementById('modal').innerHTML=''">
		<div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
			<button type="button" class="modal-close" aria-label="Close" onclick="document.getElementById('modal').innerHTML=''">
				<span class="material-symbols-outlined">close</span>
			</button>
			<div class="row gap-12 wrap center" style="margin-bottom: 10px;">
				<span class="eyebrow">Connect from</span>
				@nodeTypeChip(fromNode.Type)
			</div>
			<h2 id="modal-title" style="margin: 0 0 6px; font-size: 22px;">{ fromNode.Title }</h2>
			<p class="muted" style="margin: 0 0 18px; font-size: 13px;">
				Create a directed connection from this node to another.
			</p>
			@Flash(flash)
			<form
				method="post"
				action={ templ.SafeURL("/nodes/" + fromNode.Slug + "/edges") }
				class="form"
				hx-post={ "/nodes/" + fromNode.Slug + "/edges" }
				hx-target="#modal"
				hx-swap="innerHTML"
			>
				@edgeFormFields(fromNode, formKind, find, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">conversion_path</span>Add connection</button>
					<button type="button" class="btn ghost" onclick="document.getElementById('modal').innerHTML=''"><span class="material-symbols-outlined">close</span>Cancel</button>
				</div>
			</form>
		</div>
	</div>
}

templ edgeFormFields(fromNode db.Node, formKind, find string, candidates []EdgeCandidate) {
	@CSRFField()
	<fieldset class="toggle-group">
		<legend>Relationship kind</legend>
		<div class="toggle-btns">
			<label class="toggle-btn" data-edge-kind="supports">
				<input type="radio" name="kind" value="supports" required checked?={ formKind == "supports" || formKind == "" }/>
				<span class="material-symbols-outlined">thumb_up</span>
				Supports
			</label>
			<label class="toggle-btn" data-edge-kind="opposes">
				<input type="radio" name="kind" value="opposes" checked?={ formKind == "opposes" }/>
				<span class="material-symbols-outlined">thumb_down</span>
				Opposes
			</label>
			<label class="toggle-btn" data-edge-kind="refines">
				<input type="radio" name="kind" value="refines" checked?={ formKind == "refines" }/>
				<span class="material-symbols-outlined">tune</span>
				Refines
			</label>
			<label class="toggle-btn" data-edge-kind="cites">
				<input type="radio" name="kind" value="cites" checked?={ formKind == "cites" }/>
				<span class="material-symbols-outlined">format_quote</span>
				Cites
			</label>
			<label class="toggle-btn" data-edge-kind="relates_to">
				<input type="radio" name="kind" value="relates_to" checked?={ formKind == "relates_to" }/>
				<span class="material-symbols-outlined">link</span>
				Relates to
			</label>
		</div>
		<small class="muted" style="font-size: 12px;">How the source relates to the target — supports backs it, opposes argues against, refines clarifies, cites references, relates_to is a loose link.</small>
	</fieldset>
	<label>
		Find target node
		<input
			type="search"
			name="find"
			value={ find }
			placeholder="search by title or body…"
			hx-get={ "/nodes/" + fromNode.Slug + "/edges/picker" }
			hx-trigger="input changed delay:200ms, search"
			hx-target="#picker-target"
			hx-swap="outerHTML"
		/>
		<small>Results update as you type.</small>
	</label>
	@CandidatePicker(find, candidates)
}

templ NodeDelete(viewer *Viewer, node db.Node, edgeCount, otherPinCount int64) {
	@Layout("Delete "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Delete</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 12px;">This permanently removes the node. The action cannot be undone.</p>
			<ul class="muted" style="margin: 0 0 24px; padding-left: 20px; line-height: 1.7;">
				<li>{ cascadeEdgeLabel(edgeCount) } will be removed.</li>
				<li>{ cascadePinLabel(otherPinCount) }</li>
				<li>Findings attached to other users' pins will detach (the pins survive without a finding).</li>
				<li>Tags lose their link to this node, but the tags themselves remain.</li>
			</ul>
			<form method="post" action={ templ.SafeURL("/nodes/" + node.Slug + "/delete") } class="form">
				@CSRFField()
				<div class="form-row">
					<button type="submit" class="btn danger"><span class="material-symbols-outlined">delete_forever</span>Yes, delete this node</button>
					<a href={ templ.SafeURL("/nodes/" + node.Slug) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// CandidatePicker is rendered both on the full /edges/new page and as a
// fragment via HTMX live-search. The outer div has a stable id so HTMX can
// target it with hx-swap="outerHTML" — each fragment response replaces the
// previous one in place.
templ CandidatePicker(find string, candidates []EdgeCandidate) {
	<div id="picker-target">
		if find == "" {
			<p class="muted">Start typing in the search box above to see matching nodes.</p>
		}
		if find != "" && len(candidates) == 0 {
			<p class="muted">No nodes match that query.</p>
		}
		if find != "" && len(candidates) > 0 {
			<fieldset class="form-fieldset candidate-list">
				<legend>Pick a target</legend>
				for _, c := range candidates {
					<label class="radio">
						<input type="radio" name="to_id" value={ c.ID.String() } required/>
						@nodeTypeChip(c.Type)
						<span>{ c.Title }</span>
					</label>
				}
			</fieldset>
		}
	</div>
}
