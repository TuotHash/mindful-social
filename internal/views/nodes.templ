package views

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/TuotHash/mindful-social/internal/db"
)

templ NodeNew(viewer *Viewer, flash string, formType, formTitle, formBody, formSourceURL, formPin, formTags string) {
	@Layout("New node", viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Add to the graph</span>
				<h1 class="h-1">Add a node</h1>
				<p class="muted" style="margin: 0;">Pick a type. Topics group views; views are stances; reasonings are arguments; evidence is the external sources you cite.</p>
			</div>
			@Flash(flash)
			<form method="post" action="/nodes" class="form">
				<label>
					Type
					<select name="type" required>
						<option value="topic" selected?={ formType == "topic" || formType == "" }>Topic</option>
						<option value="view" selected?={ formType == "view" }>View</option>
						<option value="reasoning" selected?={ formType == "reasoning" }>Reasoning</option>
						<option value="evidence" selected?={ formType == "evidence" }>Evidence / Source</option>
					</select>
				</label>
				<label>
					Title
					<input type="text" name="title" required maxlength="200" value={ formTitle }/>
				</label>
				<label>
					Body
					<textarea name="body" rows="6">{ formBody }</textarea>
					<small>Optional. Describe the node in your own words.</small>
				</label>
				<label>
					Source URL <small>(evidence only)</small>
					<input type="url" name="source_url" value={ formSourceURL }/>
				</label>
				<label>
					Tags <small>(comma-separated, optional)</small>
					<input type="text" name="tags" value={ formTags } placeholder="climate, energy, ethics"/>
				</label>
				<fieldset class="form-fieldset">
					<legend>Pin to my profile <small>(optional)</small></legend>
					<label class="radio">
						<input type="radio" name="pin" value="" checked?={ formPin == "" }/>
						Don't pin
					</label>
					<label class="radio">
						<input type="radio" name="pin" value="featured" checked?={ formPin == "featured" }/>
						Feature on my profile
					</label>
					<label class="radio">
						<input type="radio" name="pin" value="supports" checked?={ formPin == "supports" }/>
						Support <small>(views only)</small>
					</label>
					<label class="radio">
						<input type="radio" name="pin" value="opposes" checked?={ formPin == "opposes" }/>
						Oppose <small>(views only)</small>
					</label>
				</fieldset>
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">add</span>Create node</button>
					<a href="/" class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// EdgeRow is one entry in a legend section. Outgoing is true when this row
// represents an edge that *originates* at the current node (eligible for the
// "Feature" button); false for incoming edges where the current node is the
// destination.
type EdgeRow struct {
	EdgeID   uuid.UUID
	Kind     db.EdgeKind
	Outgoing bool
	ID       uuid.UUID
	Type     db.NodeType
	Title    string
}

// EdgeGroup is one section of the legend: a heading ("Supports", "Supported
// by", "Relates to", …) and the rows that fall under it.
type EdgeGroup struct {
	Label string
	Kind  db.EdgeKind
	Rows  []EdgeRow
}

// FeaturedRow is one card in the "Key reasoning" section, where the
// destination node's body is rendered inline rather than just linked.
type FeaturedRow struct {
	EdgeID uuid.UUID
	Kind   db.EdgeKind
	Label  string // human-readable kind, e.g. "Supports"
	ID     uuid.UUID
	Type   db.NodeType
	Title  string
	Body   string
}

// PinInfo is non-nil when the current viewer has pinned the node being
// rendered. ReasoningTitle is empty when the pin has no attached reasoning.
type PinInfo struct {
	Kind           db.PinKind
	ReasoningID    *uuid.UUID
	ReasoningTitle string
}

// ReasoningOption is one row in the reasoning-picker dropdown on the
// pin-to-profile form: a node id and its title.
type ReasoningOption struct {
	ID    uuid.UUID
	Title string
}

// pinKindLabel turns a PinKind value into the verb shown in the UI banner
// ("You support this", "You oppose this", "On your profile").
func pinKindLabel(k db.PinKind) string {
	switch k {
	case db.PinKindSupports:
		return "You support this"
	case db.PinKindOpposes:
		return "You oppose this"
	case db.PinKindFeatured:
		return "On your profile"
	}
	return string(k)
}

// pinBannerClass adds a kind-specific modifier so CSS can color the banner
// (green for supports, red for opposes, neutral for featured).
func pinBannerClass(k db.PinKind) string {
	return "pin-banner pin-" + string(k)
}

// cascadeEdgeLabel renders the edge-count line on the deletion confirmation
// page. Pluralized so "1 connection" reads naturally next to the larger plural.
func cascadeEdgeLabel(n int64) string {
	if n == 1 {
		return "1 connection"
	}
	return fmt.Sprintf("%d connections", n)
}

// cascadePinLabel renders the other-users'-pins line. None at all gets a
// distinct phrasing — "0 pins from other users" reads worse than "No other
// users have pinned this."
func cascadePinLabel(n int64) string {
	if n == 0 {
		return "No other users have pinned this node."
	}
	if n == 1 {
		return "1 other user's pin to this node will be removed."
	}
	return fmt.Sprintf("%d other users' pins to this node will be removed.", n)
}

// nodeTypeChip renders a chip with the node-type pastel.
templ nodeTypeChip(t db.NodeType) {
	<span class={ "chip", string(t) }>
		<span class="dot"></span>
		{ string(t) }
	</span>
}

templ NodeDetail(viewer *Viewer, node db.Node, featured []FeaturedRow, groups []EdgeGroup, pin *PinInfo, tags []db.Tag) {
	@Layout(node.Title, viewer) {
		<div class="page medium">
			<article class="node card" style="padding: 36px;">
				<header class="node-header">
					@nodeTypeChip(node.Type)
					<span class="grow"></span>
				</header>
				<h1 style="margin-top: 18px;">{ node.Title }</h1>
				if node.Body != "" {
					<section class="body" style="margin-top: 14px;">
						<p>{ node.Body }</p>
					</section>
				}
				if node.SourceUrl != nil && *node.SourceUrl != "" {
					<section class="source" style="margin-top: 14px;">
						<a href={ templ.SafeURL(*node.SourceUrl) } target="_blank" rel="noopener">↗ { *node.SourceUrl }</a>
					</section>
				}
				if len(tags) > 0 {
					<section class="node-tags" style="margin-top: 18px;">
						for _, t := range tags {
							<a href={ templ.SafeURL("/tags/" + t.Name) } class="tag">#{ t.Name }</a>
						}
					</section>
				}
				if viewer != nil {
					<div class="node-actions" style="margin-top: 22px;">
						<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/new") } class="btn"><span class="material-symbols-outlined">conversion_path</span>Connect</a>
						<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/edit") } class="btn ghost"><span class="material-symbols-outlined">edit</span>Edit</a>
						if pin == nil {
							<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/pin") } class="btn accent">
								if node.Type == db.NodeTypeView {
									<span class="material-symbols-outlined">push_pin</span>Pin to my profile
								} else {
									<span class="material-symbols-outlined">keep</span>Feature on my profile
								}
							</a>
						}
						if viewer.ID == node.CreatedBy.String() {
							<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/delete") } class="btn danger"><span class="material-symbols-outlined">delete</span>Delete</a>
						}
					</div>
				}
				if viewer != nil && pin != nil {
					<div class={ pinBannerClass(pin.Kind) } style="margin-top: 18px;">
						<strong>{ pinKindLabel(pin.Kind) }.</strong>
						if pin.ReasoningID != nil {
							via
							<a href={ templ.SafeURL("/nodes/" + pin.ReasoningID.String()) }>{ pin.ReasoningTitle }</a>
						}
						<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/pin") } class="muted" style="margin-left: auto; font-size: 13px; display: inline-flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 14px;">edit</span>Change</a>
						<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/unpin") } class="inline">
							<button type="submit" class="link" style="display: inline-flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 14px;">pin_off</span>Remove</button>
						</form>
					</div>
				}
			</article>

			if len(featured) > 0 {
				<section class="featured">
					<h2>Key reasoning</h2>
					for _, f := range featured {
						<article class={ "featured-card", "edge-" + string(f.Kind) }>
							<header class="featured-head">
								<span class="kind-label">{ f.Label }</span>
								@nodeTypeChip(f.Type)
								<span class="grow"></span>
							</header>
							<h3><a href={ templ.SafeURL("/nodes/" + f.ID.String()) }>{ f.Title }</a></h3>
							if f.Body != "" {
								<p>{ f.Body }</p>
							}
							if viewer != nil {
								<div class="row gap-8 wrap" style="margin-top: 12px;">
									<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/" + f.EdgeID.String() + "/unfeature") } class="inline">
										<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">keep_off</span>Unfeature</button>
									</form>
									<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/" + f.EdgeID.String() + "/delete") } class="inline">
										<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">conversion_path_off</span>Disconnect</button>
									</form>
								</div>
							}
						</article>
					}
				</section>
			}

			<aside class="legend">
				<h2>Connections</h2>
				if len(groups) == 0 {
					<p class="muted">No connections yet.</p>
				} else {
					for _, g := range groups {
						<div class={ "edge-group", "edge-" + string(g.Kind) }>
							<h4>{ g.Label }</h4>
							<ul>
								for _, r := range g.Rows {
									<li>
										<a href={ templ.SafeURL("/nodes/" + r.ID.String()) }>
											@nodeTypeChip(r.Type)
											<span class="title">{ r.Title }</span>
										</a>
										if viewer != nil {
											<div class="edge-actions">
												if r.Outgoing {
													<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/" + r.EdgeID.String() + "/feature") } class="inline">
														<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">keep</span>Feature</button>
													</form>
												}
												<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/" + r.EdgeID.String() + "/delete") } class="inline">
													<button type="submit" class="btn ghost sm"><span class="material-symbols-outlined">conversion_path_off</span>Disconnect</button>
												</form>
											</div>
										}
									</li>
								}
							</ul>
						</div>
					}
				}
			</aside>
		</div>
	}
}

templ NodeEdit(viewer *Viewer, node db.Node, flash string, formTitle, formBody, formSourceURL, formTags string) {
	@Layout("Edit "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Edit</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 8px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">The node type cannot be changed after creation.</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String()) } class="form">
				<label>
					Title
					<input type="text" name="title" required maxlength="200" value={ formTitle }/>
				</label>
				<label>
					Body
					<textarea name="body" rows="6">{ formBody }</textarea>
					<small>Optional. Describe the node in your own words.</small>
				</label>
				<label>
					Source URL
					if node.Type == db.NodeTypeEvidence {
						<small>(required for evidence)</small>
					} else {
						<small>(optional)</small>
					}
					<input type="url" name="source_url" value={ formSourceURL }/>
				</label>
				<label>
					Tags <small>(comma-separated, optional)</small>
					<input type="text" name="tags" value={ formTags } placeholder="climate, energy, ethics"/>
				</label>
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">save</span>Save changes</button>
					<a href={ templ.SafeURL("/nodes/" + node.ID.String()) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

templ PinForm(viewer *Viewer, node db.Node, flash, formKind, formReasoningID string, reasonings []ReasoningOption) {
	@Layout("Pin "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Pin</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">
				Pin this node to your profile. For views you can take a stance —
				support or oppose — and optionally attach one of your reasoning nodes
				to explain why. For other node types you can just feature it.
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/pin") } class="form">
				<fieldset class="form-fieldset">
					<legend>Stance</legend>
					if node.Type == db.NodeTypeView {
						<label class="radio">
							<input type="radio" name="kind" value="supports" checked?={ formKind == "supports" }/>
							Support
						</label>
						<label class="radio">
							<input type="radio" name="kind" value="opposes" checked?={ formKind == "opposes" }/>
							Oppose
						</label>
					}
					<label class="radio">
						<input type="radio" name="kind" value="featured" checked?={ formKind == "featured" || (formKind == "" && node.Type != db.NodeTypeView) }/>
						Just feature
					</label>
				</fieldset>
				<label>
					Reasoning <small>(optional)</small>
					<select name="reasoning_id">
						<option value="">— No specific reasoning —</option>
						for _, r := range reasonings {
							<option value={ r.ID.String() } selected?={ r.ID.String() == formReasoningID }>{ r.Title }</option>
						}
					</select>
					if len(reasonings) == 0 {
						<small>You haven't authored any reasoning nodes yet. You can still pin without one, or <a href="/nodes/new">create a reasoning node</a> first.</small>
					}
				</label>
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">push_pin</span>Save pin</button>
					<a href={ templ.SafeURL("/nodes/" + node.ID.String()) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// EdgeCandidate is the slim row the edge-creation picker renders for each
// search hit: just enough to show a labelled radio button.
type EdgeCandidate struct {
	ID    uuid.UUID
	Type  db.NodeType
	Title string
}

templ EdgeNew(viewer *Viewer, fromNode db.Node, flash, formKind, find string, candidates []EdgeCandidate) {
	@Layout("Add connection", viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Connect from</span>
				@nodeTypeChip(fromNode.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ fromNode.Title }</h1>
			<p class="muted" style="margin: 0 0 24px;">
				You are creating a directed connection <strong>from</strong> this node <strong>to</strong> another.
				The kind describes how the source relates to the target.
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + fromNode.ID.String() + "/edges") } class="form">
				<label>
					Relationship kind
					<select name="kind" required>
						<option value="supports" selected?={ formKind == "supports" || formKind == "" }>Supports — the source backs the target</option>
						<option value="opposes" selected?={ formKind == "opposes" }>Opposes — the source argues against the target</option>
						<option value="refines" selected?={ formKind == "refines" }>Refines — the source clarifies or narrows the target</option>
						<option value="cites" selected?={ formKind == "cites" }>Cites — the source references the target as evidence</option>
						<option value="relates_to" selected?={ formKind == "relates_to" }>Relates to — loosely connected</option>
					</select>
				</label>
				<label>
					Find target node
					<input
						type="search"
						name="find"
						value={ find }
						placeholder="search by title or body…"
						hx-get={ "/nodes/" + fromNode.ID.String() + "/edges/picker" }
						hx-trigger="input changed delay:200ms, search"
						hx-target="#picker-target"
						hx-swap="outerHTML"
					/>
					<small>Results update as you type.</small>
				</label>
				@CandidatePicker(find, candidates)
				<div class="form-row">
					<button type="submit" class="btn accent"><span class="material-symbols-outlined">conversion_path</span>Add connection</button>
					<a href={ templ.SafeURL("/nodes/" + fromNode.ID.String()) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

templ NodeDelete(viewer *Viewer, node db.Node, edgeCount, otherPinCount int64) {
	@Layout("Delete "+node.Title, viewer) {
		<div class="page narrow">
			<div class="row gap-12 wrap center" style="margin-bottom: 18px;">
				<span class="eyebrow">Delete</span>
				@nodeTypeChip(node.Type)
			</div>
			<h1 class="h-1" style="margin-bottom: 12px; font-size: 36px;">{ node.Title }</h1>
			<p class="muted" style="margin: 0 0 12px;">This permanently removes the node. The action cannot be undone.</p>
			<ul class="muted" style="margin: 0 0 24px; padding-left: 20px; line-height: 1.7;">
				<li>{ cascadeEdgeLabel(edgeCount) } will be removed.</li>
				<li>{ cascadePinLabel(otherPinCount) }</li>
				<li>Reasonings attached to other users' pins will detach (the pins survive without a reasoning).</li>
				<li>Tags lose their link to this node, but the tags themselves remain.</li>
			</ul>
			<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/delete") } class="form">
				<div class="form-row">
					<button type="submit" class="btn danger"><span class="material-symbols-outlined">delete_forever</span>Yes, delete this node</button>
					<a href={ templ.SafeURL("/nodes/" + node.ID.String()) } class="btn ghost"><span class="material-symbols-outlined">close</span>Cancel</a>
				</div>
			</form>
		</div>
	}
}

// CandidatePicker is rendered both on the full /edges/new page and as a
// fragment via HTMX live-search. The outer div has a stable id so HTMX can
// target it with hx-swap="outerHTML" — each fragment response replaces the
// previous one in place.
templ CandidatePicker(find string, candidates []EdgeCandidate) {
	<div id="picker-target">
		if find == "" {
			<p class="muted">Start typing in the search box above to see matching nodes.</p>
		}
		if find != "" && len(candidates) == 0 {
			<p class="muted">No nodes match that query.</p>
		}
		if find != "" && len(candidates) > 0 {
			<fieldset class="form-fieldset candidate-list">
				<legend>Pick a target</legend>
				for _, c := range candidates {
					<label class="radio">
						<input type="radio" name="to_id" value={ c.ID.String() } required/>
						@nodeTypeChip(c.Type)
						<span>{ c.Title }</span>
					</label>
				}
			</fieldset>
		}
	</div>
}
