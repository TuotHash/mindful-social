package views

import (
	"github.com/google/uuid"
	"github.com/mindful-social/mindful-social/internal/db"
)

templ NodeNew(viewer *Viewer, flash string, formType, formTitle, formBody, formSourceURL string) {
	@Layout("New node", viewer) {
		<section class="auth">
			<h1>Add a node</h1>
			<p class="muted">Pick a type. Topics group views; views are stances; reasonings are arguments; facts are external sources you cite.</p>
			@Flash(flash)
			<form method="post" action="/nodes" class="form">
				<label>
					Type
					<select name="type" required>
						<option value="topic" selected?={ formType == "topic" || formType == "" }>Topic</option>
						<option value="view" selected?={ formType == "view" }>View</option>
						<option value="reasoning" selected?={ formType == "reasoning" }>Reasoning</option>
						<option value="fact" selected?={ formType == "fact" }>Fact / Source</option>
					</select>
				</label>
				<label>
					Title
					<input type="text" name="title" required maxlength="200" value={ formTitle }/>
				</label>
				<label>
					Body
					<textarea name="body" rows="6">{ formBody }</textarea>
					<small>Optional. Describe the node in your own words.</small>
				</label>
				<label>
					Source URL <small>(facts only)</small>
					<input type="url" name="source_url" value={ formSourceURL }/>
				</label>
				<button type="submit" class="btn primary">Create node</button>
			</form>
		</section>
	}
}

// EdgeRow is the projection ListEdgesFromNode / ListEdgesToNode return —
// templates render it directly so handlers don't have to repackage.
type EdgeRow struct {
	EdgeID   uuid.UUID
	Kind     db.EdgeKind
	Featured bool
	ID       uuid.UUID
	Type     db.NodeType
	Title    string
}

// EdgeGroup is one section of the legend on a node detail page: a heading
// (e.g. "Supports") and the rows that fall under it.
type EdgeGroup struct {
	Label string
	Kind  db.EdgeKind
	Rows  []EdgeRow
}

// FeaturedRow is one card in the "Key reasoning" section, where the
// destination node's body is rendered inline rather than just linked.
type FeaturedRow struct {
	EdgeID uuid.UUID
	Kind   db.EdgeKind
	Label  string // human-readable kind, e.g. "Supports"
	ID     uuid.UUID
	Type   db.NodeType
	Title  string
	Body   string
}

templ NodeDetail(viewer *Viewer, node db.Node, featured []FeaturedRow, outgoing, incoming []EdgeGroup) {
	@Layout(node.Title, viewer) {
		<article class="node">
			<header>
				<span class={ "badge", "badge-" + string(node.Type) }>{ string(node.Type) }</span>
				<h1>{ node.Title }</h1>
			</header>
			if node.Body != "" {
				<section class="body">
					<p>{ node.Body }</p>
				</section>
			}
			if node.SourceUrl != nil && *node.SourceUrl != "" {
				<section class="source">
					<a href={ templ.SafeURL(*node.SourceUrl) } target="_blank" rel="noopener">{ *node.SourceUrl }</a>
				</section>
			}
			if viewer != nil {
				<div class="node-actions">
					<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/new") } class="btn">+ Connect</a>
					<a href={ templ.SafeURL("/nodes/" + node.ID.String() + "/edit") } class="btn">Edit</a>
				</div>
			}
		</article>

		if len(featured) > 0 {
			<section class="featured">
				<h2>Key reasoning</h2>
				for _, f := range featured {
					<article class={ "featured-card", "edge-" + string(f.Kind) }>
						<header class="featured-head">
							<span class="kind-label">{ f.Label }</span>
							<span class={ "badge", "badge-" + string(f.Type) }>{ string(f.Type) }</span>
							<h3><a href={ templ.SafeURL("/nodes/" + f.ID.String()) }>{ f.Title }</a></h3>
						</header>
						if f.Body != "" {
							<p>{ f.Body }</p>
						}
						if viewer != nil {
							<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String() + "/edges/" + f.EdgeID.String() + "/unfeature") } class="inline">
								<button type="submit" class="link">Unfeature</button>
							</form>
						}
					</article>
				}
			</section>
		}

		<aside class="legend">
			<h2>Legend</h2>
			<section>
				<h3>This node points at…</h3>
				@edgeGroups(outgoing, "outgoing", node.ID, viewer)
			</section>
			<section>
				<h3>…what points at this node</h3>
				@edgeGroups(incoming, "incoming", node.ID, viewer)
			</section>
		</aside>
	}
}

templ NodeEdit(viewer *Viewer, node db.Node, flash string, formTitle, formBody, formSourceURL string) {
	@Layout("Edit "+node.Title, viewer) {
		<section>
			<h1>
				Edit
				<span class={ "badge", "badge-" + string(node.Type) }>{ string(node.Type) }</span>
			</h1>
			<p class="muted">The node type cannot be changed after creation.</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + node.ID.String()) } class="form">
				<label>
					Title
					<input type="text" name="title" required maxlength="200" value={ formTitle }/>
				</label>
				<label>
					Body
					<textarea name="body" rows="6">{ formBody }</textarea>
					<small>Optional. Describe the node in your own words.</small>
				</label>
				<label>
					Source URL
					if node.Type == db.NodeTypeFact {
						<small>(required for facts)</small>
					} else {
						<small>(optional)</small>
					}
					<input type="url" name="source_url" value={ formSourceURL }/>
				</label>
				<div class="form-row">
					<button type="submit" class="btn primary">Save changes</button>
					<a href={ templ.SafeURL("/nodes/" + node.ID.String()) } class="btn">Cancel</a>
				</div>
			</form>
		</section>
	}
}

templ EdgeNew(viewer *Viewer, fromNode db.Node, flash string, formKind string, candidates []db.Node) {
	@Layout("Add connection", viewer) {
		<section>
			<h1>
				Connect from
				<span class={ "badge", "badge-" + string(fromNode.Type) }>{ string(fromNode.Type) }</span>
				{ fromNode.Title }
			</h1>
			<p class="muted">
				You are creating a directed connection <strong>from</strong> this node <strong>to</strong> another.
				The kind describes how the source relates to the target.
			</p>
			@Flash(flash)
			<form method="post" action={ templ.SafeURL("/nodes/" + fromNode.ID.String() + "/edges") } class="form">
				<label>
					Relationship kind
					<select name="kind" required>
						<option value="supports" selected?={ formKind == "supports" || formKind == "" }>Supports — the source backs the target</option>
						<option value="opposes" selected?={ formKind == "opposes" }>Opposes — the source argues against the target</option>
						<option value="refines" selected?={ formKind == "refines" }>Refines — the source clarifies or narrows the target</option>
						<option value="cites" selected?={ formKind == "cites" }>Cites — the source references the target as evidence</option>
						<option value="relates_to" selected?={ formKind == "relates_to" }>Relates to — loosely connected</option>
					</select>
				</label>
				<label>
					Target node
					<select name="to_id" required size="12" class="node-picker">
						for _, n := range candidates {
							<option value={ n.ID.String() }>{ string(n.Type) } — { n.Title }</option>
						}
					</select>
					<small>Click to select. Type in a browser find (Ctrl+F) to search.</small>
				</label>
				<div class="form-row">
					<button type="submit" class="btn primary">Add connection</button>
					<a href={ templ.SafeURL("/nodes/" + fromNode.ID.String()) } class="btn">Cancel</a>
				</div>
			</form>
		</section>
	}
}

templ edgeGroups(groups []EdgeGroup, dir string, sourceID uuid.UUID, viewer *Viewer) {
	if hasAnyVisibleEdges(groups, dir) {
		for _, g := range groups {
			if hasVisibleRows(g, dir) {
				<div class={ "edge-group", "edge-" + string(g.Kind) }>
					<h4>{ g.Label }</h4>
					<ul>
						for _, r := range g.Rows {
							if !(dir == "outgoing" && r.Featured) {
								<li>
									<a href={ templ.SafeURL("/nodes/" + r.ID.String()) }>
										<span class={ "badge", "badge-" + string(r.Type) }>{ string(r.Type) }</span>
										<span class="title">{ r.Title }</span>
									</a>
									if dir == "outgoing" && viewer != nil {
										<form method="post" action={ templ.SafeURL("/nodes/" + sourceID.String() + "/edges/" + r.EdgeID.String() + "/feature") } class="inline edge-action">
											<button type="submit" class="link">Feature</button>
										</form>
									}
								</li>
							}
						}
					</ul>
				</div>
			}
		}
	} else {
		<p class="muted">Nothing yet.</p>
	}
}

// In the outgoing direction, featured rows are rendered in the "Key reasoning"
// section above and skipped here, so a group is "visible" only if it has at
// least one non-featured row.
func hasVisibleRows(g EdgeGroup, dir string) bool {
	for _, r := range g.Rows {
		if dir == "outgoing" && r.Featured {
			continue
		}
		return true
	}
	return false
}

func hasAnyVisibleEdges(groups []EdgeGroup, dir string) bool {
	for _, g := range groups {
		if hasVisibleRows(g, dir) {
			return true
		}
	}
	return false
}
