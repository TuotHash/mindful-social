package views

import (
	"strconv"

	"github.com/TuotHash/mindful-social/internal/db"
)

templ TagsIndex(viewer *Viewer, tags []db.ListAllTagsRow) {
	@Layout("Tags", viewer) {
		<div class="page medium">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Browse the graph</span>
				<h1 class="h-1">Tags</h1>
				<p class="muted" style="margin: 0;">Free-form labels that group nodes across types. Click a tag to see everything carrying it.</p>
			</div>
			if len(tags) == 0 {
				<div class="card muted" style="text-align: center; padding: 24px;">No tags yet. Add some when you create or edit a node.</div>
			} else {
				<ul class="tag-cloud">
					for _, t := range tags {
						<li>
							<a href={ templ.SafeURL("/tags/" + t.Name) } class="tag-chip">#{ t.Name }</a>
							<span class="tag-count">{ strconv.FormatInt(t.NodeCount, 10) }</span>
						</li>
					}
				</ul>
			}
		</div>
	}
}

templ TagDetail(viewer *Viewer, name string, nodes []db.Node) {
	@Layout("#"+name, viewer) {
		<div class="page medium">
			<div class="row gap-8 center" style="margin-bottom: 18px; font-size: 13px; color: var(--ink-3); font-family: var(--mono);">
				<a href="/tags" style="text-decoration: none;">tags</a>
				<span>/</span>
				<span style="color: var(--ink-2);">{ name }</span>
			</div>
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Tag</span>
				<h1 class="h-1">#{ name }</h1>
				<p class="muted" style="margin: 0;">Nodes carrying this tag, most recent first.</p>
			</div>
			if len(nodes) == 0 {
				<div class="card muted" style="text-align: center; padding: 24px;">No nodes with this tag yet.</div>
			} else {
				<ul class="node-list">
					for _, n := range nodes {
						<li>
							<a href={ templ.SafeURL("/nodes/" + n.Slug) }>
								<span class={ "chip", string(n.Type) }>
									<span class="dot"></span>
									{ string(n.Type) }
								</span>
								<span class="title">{ n.Title }</span>
							</a>
						</li>
					}
				</ul>
			}
			<p class="muted" style="margin-top: 24px;"><a href="/tags" style="color: inherit;">← All tags</a></p>
		</div>
	}
}
