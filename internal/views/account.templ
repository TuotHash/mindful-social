package views

import (
	"fmt"
	"path"
	"time"

	"github.com/google/uuid"

	"github.com/TuotHash/mindful-social/internal/db"
)

// AccountIdentity is one row in the account page's "Sign-in methods" list.
// Label is the human-friendly provider name; Subject is the email or oauth
// subject shown alongside it. CanDisconnect is false on the last remaining
// identity so the UI can disable the button.
type AccountIdentity struct {
	ID            uuid.UUID
	Provider      string
	Label         string
	Subject       string
	CanDisconnect bool
}

// AccountMediaItem is one file the account owner uploaded through a node
// editor. Profile images are stored directly on the user row and are not
// part of this media history.
type AccountMediaItem struct {
	Kind           string
	Path           string
	ContentType    string
	ByteSize       int64
	Width          int32
	Height         int32
	DurationMs     int32
	CreatedAt      time.Time
	RootTopicSlug  string
	RootTopicTitle string
}

// AccountTimezones is the curated list of IANA zones shown in the timezone
// dropdown. Empty string = fall back to UTC. Kept short on purpose: a full
// IANA list is ~600 entries and overwhelms the form.
var AccountTimezones = []string{
	"Pacific/Honolulu",
	"America/Anchorage",
	"America/Los_Angeles",
	"America/Denver",
	"America/Chicago",
	"America/New_York",
	"America/Halifax",
	"America/Sao_Paulo",
	"Atlantic/Azores",
	"Europe/London",
	"Europe/Berlin",
	"Europe/Paris",
	"Europe/Madrid",
	"Europe/Rome",
	"Europe/Amsterdam",
	"Europe/Stockholm",
	"Europe/Athens",
	"Europe/Istanbul",
	"Africa/Cairo",
	"Africa/Lagos",
	"Africa/Johannesburg",
	"Asia/Dubai",
	"Asia/Karachi",
	"Asia/Kolkata",
	"Asia/Bangkok",
	"Asia/Singapore",
	"Asia/Shanghai",
	"Asia/Tokyo",
	"Australia/Sydney",
	"Pacific/Auckland",
}

templ Account(viewer *Viewer, user db.User, identities []AccountIdentity, media []AccountMediaItem, hasPassword bool, prefVisibility, prefTimezone, flash, success string) {
	@Layout("Account", viewer) {
		<div class="page narrow">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Preferences</span>
				<h1 class="h-1">Account</h1>
				<p class="muted" style="margin: 0;">Set defaults for new nodes, pick your timezone, and manage how you sign in.</p>
			</div>
			@Flash(flash)
			if success != "" {
				<div class="flash" role="status" style="background: color-mix(in oklch, var(--supports) 14%, var(--bg)); border-color: color-mix(in oklch, var(--supports) 40%, transparent);">{ success }</div>
			}

			<section class="card" style="padding: 20px;">
				<h2 style="margin-top: 0;">Preferences</h2>
				<p class="muted" style="margin-top: 0;">Defaults applied when you create a new node and when timestamps are displayed.</p>
				<form method="post" action="/account/preferences" class="form">
					@CSRFField()
					@visibilitySelect(prefVisibility)
					<label>
						Timezone
						<select name="timezone">
							<option value="" selected?={ prefTimezone == "" }>UTC (default)</option>
							for _, tz := range AccountTimezones {
								<option value={ tz } selected?={ prefTimezone == tz }>{ tz }</option>
							}
						</select>
						<small class="muted" style="font-size: 12px;">Used when timestamps are shown on the site. Empty falls back to UTC.</small>
					</label>
					<div class="form-row">
						<button type="submit" class="btn accent">Save preferences</button>
					</div>
				</form>
			</section>

			<section class="card" style="padding: 20px; margin-top: 24px;">
				<h2 style="margin-top: 0;">Details</h2>
				<div class="account-field">
					<div class="account-field-label">Profile picture</div>
					<div class="row gap-12 center wrap" style="margin-top: 8px;">
						@AvatarImage(user.Username, user.ProfileImagePath, 56)
						<form method="post" action="/account/profile-image" enctype="multipart/form-data" class="inline">
							@CSRFField()
							<input type="file" name="profile_image" accept="image/png,image/jpeg,image/gif" required/>
							<button type="submit" class="btn ghost sm">Upload</button>
						</form>
					</div>
					<div class="account-field-note muted">PNG, JPEG, or GIF. Up to 12 MB upload, auto-resized and compressed to a max 2048 px edge and under 2 MB.</div>
				</div>
				<div class="account-field">
					<div class="account-field-label">Username</div>
					<div class="account-field-value">{ user.Username }</div>
					<div class="account-field-note muted">Changing usernames isn't available yet</div>
				</div>
				<div class="account-field">
					<div class="account-field-label">Email</div>
					<div class="account-field-value">{ user.Email }</div>
					<div class="account-field-note muted">Changing email isn't available yet</div>
				</div>
			</section>

			<section class="card" style="padding: 20px; margin-top: 24px;">
				<h2 style="margin-top: 0;">Media uploads</h2>
				if len(media) == 0 {
					<p class="muted">No node media uploads yet.</p>
				} else {
					<ul class="account-media-list">
						for _, item := range media {
							<li class="account-media-row">
								<a class="account-media-preview" href={ templ.SafeURL(item.Path) } aria-label={ "Open " + accountMediaFileName(item.Path) }>
									if item.Kind == "image" {
										<img src={ templ.SafeURL(item.Path) } alt="" loading="lazy"/>
									} else {
										<video src={ templ.SafeURL(item.Path) } muted playsinline preload="metadata"></video>
									}
								</a>
								<div class="account-media-main">
									<div class="row gap-8 wrap">
										<span class={ "chip", "media-" + item.Kind }>
											<span class="dot"></span>
											{ item.Kind }
										</span>
										<a class="account-media-name" href={ templ.SafeURL(item.Path) }>{ accountMediaFileName(item.Path) }</a>
									</div>
									<div class="account-media-meta">
										<span>{ accountMediaBytes(item.ByteSize) }</span>
										if item.ContentType != "" {
											<span>{ item.ContentType }</span>
										}
										if !item.CreatedAt.IsZero() {
											<span>{ item.CreatedAt.In(viewer.Location()).Format("Jan 2, 2006") }</span>
										}
										if item.Kind == "video" && item.Width > 0 && item.Height > 0 {
											<span>{ fmt.Sprintf("%dx%d", item.Width, item.Height) }</span>
										}
										if d := accountMediaDuration(item.DurationMs); d != "" {
											<span>{ d }</span>
										}
									</div>
									if item.RootTopicSlug != "" {
										<div class="account-media-topic">
											<span class="muted">Topic</span>
											<a href={ templ.SafeURL("/nodes/" + item.RootTopicSlug) }>{ item.RootTopicTitle }</a>
										</div>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="card" style="padding: 20px; margin-top: 24px;">
				<h2 style="margin-top: 0;">Password</h2>
				if hasPassword {
					<form method="post" action="/account/password" class="form">
						@CSRFField()
						<label>
							Current password
							<input type="password" name="current_password" required autocomplete="current-password"/>
						</label>
						<label>
							New password
							<input type="password" name="new_password" required minlength="12" autocomplete="new-password" placeholder="at least 12 characters"/>
						</label>
						<label>
							Confirm new password
							<input type="password" name="confirm_password" required minlength="12" autocomplete="new-password"/>
						</label>
						<div class="form-row">
							<button type="submit" class="btn accent">Change password</button>
						</div>
					</form>
				} else {
					<p class="muted" style="margin-top: 0;">You signed in with an external provider and haven't set a password yet. Add one to enable email + password sign-in as a backup.</p>
					<form method="post" action="/account/password" class="form">
						@CSRFField()
						<label>
							New password
							<input type="password" name="new_password" required minlength="12" autocomplete="new-password" placeholder="at least 12 characters"/>
						</label>
						<label>
							Confirm new password
							<input type="password" name="confirm_password" required minlength="12" autocomplete="new-password"/>
						</label>
						<div class="form-row">
							<button type="submit" class="btn accent">Set password</button>
						</div>
					</form>
				}
			</section>

			<section class="card" style="padding: 20px; margin-top: 24px;">
				<h2 style="margin-top: 0;">Sign-in methods</h2>
				if len(identities) == 0 {
					<p class="muted">No sign-in methods on file.</p>
				} else {
					<ul class="list-rows">
						for _, ident := range identities {
							<li class="list-row">
								<div class="list-row-main" style="cursor: default;">
									<span class="ident-label">{ ident.Label }</span>
									if ident.Subject != "" {
										<span class="muted" style="font-size: 13px;">{ ident.Subject }</span>
									}
								</div>
								if ident.CanDisconnect {
									<form method="post" action={ templ.SafeURL("/account/identities/" + ident.ID.String() + "/disconnect") } class="inline" onsubmit="return confirm('Disconnect this sign-in method? You can re-add it later by signing in with it again.')">
										@CSRFField()
										<button type="submit" class="btn ghost sm">Disconnect</button>
									</form>
								} else {
									<span class="muted" style="font-size: 13px;">Last method — can't disconnect</span>
								}
							</li>
						}
					</ul>
				}
			</section>
		</div>
	}
}

func accountMediaFileName(p string) string {
	name := path.Base(p)
	if name == "." || name == "/" {
		return p
	}
	return name
}

func accountMediaBytes(n int64) string {
	switch {
	case n < 1024:
		return fmt.Sprintf("%d B", n)
	case n < 1024*1024:
		return fmt.Sprintf("%.1f KB", float64(n)/1024)
	default:
		return fmt.Sprintf("%.1f MB", float64(n)/(1024*1024))
	}
}

func accountMediaDuration(ms int32) string {
	if ms <= 0 {
		return ""
	}
	seconds := int(ms+500) / 1000
	minutes := seconds / 60
	seconds = seconds % 60
	if minutes == 0 {
		return fmt.Sprintf("%ds", seconds)
	}
	return fmt.Sprintf("%d:%02d", minutes, seconds)
}
