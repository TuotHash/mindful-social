package views

import (
	"strconv"

	"github.com/google/uuid"
	"github.com/TuotHash/mindful-social/internal/db"
)

// SearchHit is one result on the /search page. Excerpt is split into plain
// and matched parts so templ can escape each one and surround matches with
// <mark> safely (without exposing user-authored HTML).
type SearchHit struct {
	ID      uuid.UUID
	Type    db.NodeType
	Title   string
	Excerpt []ExcerptPart
}

// ExcerptPart is one chunk of a search result's body excerpt. Match=true
// segments are wrapped in <mark> at render time.
type ExcerptPart struct {
	Text  string
	Match bool
}

templ SearchResults(viewer *Viewer, q string, hits []SearchHit) {
	@Layout("Search", viewer) {
		<div class="page medium">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Search</span>
				<h1 class="h-1">Search the graph</h1>
			</div>
			<form method="get" action="/search" class="search-form">
				<input type="search" name="q" value={ q } placeholder="search node titles and bodies…"/>
				<button type="submit" class="btn accent">Search</button>
			</form>
			if q == "" {
				<p class="muted">Type a query above to search node titles and bodies.</p>
			}
			if isQueryWithNoHits(q, hits) {
				<div class="card muted" style="text-align: center; padding: 24px;">{ noMatchesPhrase(q) }</div>
			}
			if isQueryWithHits(q, hits) {
				<p class="muted" style="margin: 0 0 12px;">{ resultsForPhrase(len(hits), q) }</p>
				<ul class="search-results">
					for _, h := range hits {
						@searchHitItem(h)
					}
				</ul>
			}
		</div>
	}
}

templ searchHitItem(h SearchHit) {
	<li>
		<a href={ templ.SafeURL("/nodes/" + h.ID.String()) } class="search-hit">
			<span class={ "chip", string(h.Type) }>
				<span class="dot"></span>
				{ string(h.Type) }
			</span>
			<span class="title">{ h.Title }</span>
		</a>
		if len(h.Excerpt) > 0 {
			<p class="search-excerpt">
				@searchExcerpt(h.Excerpt)
			</p>
		}
	</li>
}

templ searchExcerpt(parts []ExcerptPart) {
	for _, p := range parts {
		if p.Match {
			<mark>{ p.Text }</mark>
		}
		if !p.Match {
			<span>{ p.Text }</span>
		}
	}
}

func isQueryWithNoHits(q string, hits []SearchHit) bool { return q != "" && len(hits) == 0 }
func isQueryWithHits(q string, hits []SearchHit) bool   { return q != "" && len(hits) > 0 }

// resultsForPhrase returns "N results for QUERY" — folded into one Go
// expression because templ's parser refuses a paragraph that mixes two outer
// {…} interpolations with an inline element that itself contains {…}.
func resultsForPhrase(n int, q string) string {
	if n == 1 {
		return "1 result for " + q + "."
	}
	return strconv.Itoa(n) + " results for " + q + "."
}

func noMatchesPhrase(q string) string {
	return "No matches for " + q + "."
}
