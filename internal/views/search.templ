package views

import (
	"strconv"

	"github.com/google/uuid"
	"github.com/TuotHash/mindful-social/internal/db"
)

// SearchHit is one result on the /search page. Excerpt is split into plain
// and matched parts so templ can escape each one and surround matches with
// <mark> safely (without exposing user-authored HTML).
type SearchHit struct {
	ID             uuid.UUID
	Slug           string
	Type           db.NodeType
	Title          string
	AuthorUsername string
	Excerpt        []ExcerptPart
}

// UserSearchHit is one person result on the /search page.
type UserSearchHit struct {
	ID       uuid.UUID
	Username string
}

// GroupSearchHit is one community result on the /search page. Visibility
// drives the badge label so members can spot connections-only or private
// groups they already belong to.
type GroupSearchHit struct {
	ID          uuid.UUID
	Slug        string
	Name        string
	Description string
	Visibility  db.GroupVisibilityKind
	MemberCount int64
}

// ExcerptPart is one chunk of a search result's body excerpt. Match=true
// segments are wrapped in <mark> at render time.
type ExcerptPart struct {
	Text  string
	Match bool
}

templ SearchResults(viewer *Viewer, q string, hits []SearchHit, users []UserSearchHit, groups []GroupSearchHit) {
	@Layout("Search", viewer) {
		<div class="page medium">
			<div class="col gap-12" style="margin-bottom: 24px;">
				<span class="eyebrow">Search</span>
				<h1 class="h-1">Search the graph</h1>
			</div>
			<form method="get" action="/search" class="search-form">
				<div class="search-input-wrap">
					<input
						type="search"
						name="q"
						value={ q }
						placeholder="search people, groups, node titles, and bodies..."
						autocomplete="off"
						hx-get="/search/suggest"
						hx-trigger="input changed delay:200ms"
						hx-target="#search-page-suggest"
						hx-swap="innerHTML"
					/>
					<div id="search-page-suggest" class="search-suggest" hidden></div>
				</div>
				<button type="submit" class="btn accent">Search</button>
			</form>
			if q == "" {
				<p class="muted">Type a query above to search people, groups, node titles, and bodies.</p>
			}
			if isQueryWithNoHits(q, hits, users, groups) {
				<div class="card muted" style="text-align: center; padding: 24px;">{ noMatchesPhrase(q) }</div>
			}
			if q != "" && len(users) > 0 {
				<section class="search-section">
					<h2>People</h2>
					<ul class="search-results">
						for _, u := range users {
							@userSearchHitItem(u)
						}
					</ul>
				</section>
			}
			if q != "" && len(groups) > 0 {
				<section class="search-section">
					<h2>Groups</h2>
					<ul class="search-results">
						for _, g := range groups {
							@groupSearchHitItem(g)
						}
					</ul>
				</section>
			}
			if q != "" && len(hits) > 0 {
				<section class="search-section">
					<h2>Graph</h2>
					<p class="muted" style="margin: 0 0 12px;">{ resultsForPhrase(len(hits), q) }</p>
					<ul class="search-results">
						for _, h := range hits {
							@searchHitItem(h)
						}
					</ul>
				</section>
			}
		</div>
	}
}

templ groupSearchHitItem(g GroupSearchHit) {
	<li>
		<a href={ templ.SafeURL("/groups/" + g.Slug) } class="search-hit">
			<span class="title">{ g.Name }</span>
			<span class="badge">{ groupVisibilityLabel(g.Visibility) }</span>
			<span class="muted">{ groupMemberCountLabel(g.MemberCount) }</span>
		</a>
		if g.Description != "" {
			<p class="search-excerpt"><span>{ g.Description }</span></p>
		}
	</li>
}

templ userSearchHitItem(u UserSearchHit) {
	<li>
		<a href={ templ.SafeURL("/users/" + u.Username) } class="search-hit">
			@Avatar(u.Username, 28)
			<span class="title">{ u.Username }</span>
		</a>
	</li>
}

templ searchHitItem(h SearchHit) {
	<li>
		<div class="search-hit">
			<a href={ templ.SafeURL("/nodes/" + h.Slug) } class="search-hit-link">
				<span class={ "chip", string(h.Type) }>
					<span class="dot"></span>
					{ string(h.Type) }
				</span>
				<span class="title">{ h.Title }</span>
			</a>
			<a href={ templ.SafeURL("/users/" + h.AuthorUsername) } class="node-author">
				@Avatar(h.AuthorUsername, 18)
				{ h.AuthorUsername }
			</a>
		</div>
		if len(h.Excerpt) > 0 {
			<p class="search-excerpt">
				@searchExcerpt(h.Excerpt)
			</p>
		}
	</li>
}

templ searchExcerpt(parts []ExcerptPart) {
	for _, p := range parts {
		if p.Match {
			<mark>{ p.Text }</mark>
		}
		if !p.Match {
			<span>{ p.Text }</span>
		}
	}
}

func isQueryWithNoHits(q string, hits []SearchHit, users []UserSearchHit, groups []GroupSearchHit) bool {
	return q != "" && len(hits) == 0 && len(users) == 0 && len(groups) == 0
}

// resultsForPhrase returns "N results for QUERY" — folded into one Go
// expression because templ's parser refuses a paragraph that mixes two outer
// {…} interpolations with an inline element that itself contains {…}.
func resultsForPhrase(n int, q string) string {
	if n == 1 {
		return "1 graph result for " + q + "."
	}
	return strconv.Itoa(n) + " graph results for " + q + "."
}

func noMatchesPhrase(q string) string {
	return "No matches for " + q + "."
}
