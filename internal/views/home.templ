package views

import (
	"fmt"

	"github.com/TuotHash/mindful-social/internal/db"
)

// Landing renders the public marketing page at /. Shown to everyone regardless
// of auth state — logged-in users can navigate here by clicking the brand logo.
// recentNodes is a short list of visibility-filtered nodes for the example
// section; the section is omitted when the list is empty.
templ Landing(viewer *Viewer, recentNodes []FeedItem) {
	@Layout("Home", viewer) {
		@landingMarketing(viewer, recentNodes)
	}
}

// FeedItem is a slim node row for the home feed and the landing-page teaser.
// Body is the raw markdown source; renderers turn it into a short plain-text
// excerpt where needed and ignore it otherwise.
type FeedItem struct {
	Slug           string
	Type           db.NodeType
	Title          string
	Body           string
	AuthorUsername string
	SupportsCount  int64
	OpposesCount   int64
}

// Feed renders the personal feed at /home for logged-in users.
templ Feed(viewer *Viewer, items []FeedItem) {
	@Layout("Home", viewer) {
		@homeFeed(viewer, items)
	}
}

templ landingMarketing(viewer *Viewer, recentNodes []FeedItem) {
	<section class="hero" style="margin-bottom: 0;">
		<div class="page" style="position: relative; z-index: 2;">
			<div class="hero-grid">
				<div class="col gap-24 fadein">
					<div class="row gap-8">
						<span class="chip" style="background: var(--paper);">
							<span class="dot" style="background: var(--accent-deep);"></span>
							Public alpha · early development
						</span>
					</div>
					<h1 class="h-display">
						Disagree<br/>
						<em>with grace.</em>
					</h1>
					<p class="lede" style="font-size: 21px; max-width: 50ch;">
						Mindful Social is a community where people commit to opinions,
						share their evidence, and connect ideas in a shared
						argument graph — not a feed of hot takes.
					</p>
					<div class="row gap-12 wrap">
						if SignupEnabled() {
							<a class="btn accent lg" href="/signup">
								Make your first commitment
								<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
							</a>
						} else {
							<a class="btn accent lg" href="/login">
								Sign in to commit
								<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
							</a>
						}
						<a class="btn lg" href="/graph">Read the graph</a>
					</div>
					<div class="row gap-24 wrap" style="margin-top: 12px; color: var(--ink-3); font-size: 13px;">
						<span class="row gap-8">@checkIcon() Open source · AGPL</span>
						<span class="row gap-8">@checkIcon() No ads</span>
						<span class="row gap-8">@checkIcon() Federation coming soon™</span>
					</div>
				</div>
				<div style="position: relative; height: 520px; display: flex; align-items: center; justify-content: center;">
					@bloom(420, 105, "position: absolute; right: -40px; top: 20px; opacity: 0.85; animation: drift 18s ease-in-out infinite;")
					@bloom(150, 35, "position: absolute; left: -10px; bottom: 60px; opacity: 0.85; animation: drift 14s ease-in-out infinite reverse;")
					<div class="hero-graph-card">
						<div class="row between" style="margin-bottom: 8px; padding: 0 6px;">
							<span class="eyebrow">Argument graph</span>
							<span class="chip" style="font-size: 10px; padding: 2px 8px; background: var(--accent); color: var(--accent-ink); border: 0;">Live</span>
						</div>
						<div class="hero-graph-inner">
							<div class="col gap-12" style="text-align: center; max-width: 320px; padding: 24px;">
								@bloom(120, 105, "margin: 0 auto; opacity: 0.5;")
								<div class="h-3" style="font-family: var(--serif); font-size: 22px; color: var(--ink-2);">
									Explore the graph
								</div>
								<p class="muted" style="font-size: 14px; margin: 0;">
									Trace visible topics, opinions, and evidence in one visual space.
								</p>
								<a class="btn accent sm" href="/graph" style="align-self: center;">Open graph</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	@landingRecent(recentNodes)
	<section class="section-paper">
		<div class="page" style="padding-top: 80px; padding-bottom: 80px;">
			<div class="col gap-16" style="margin-bottom: 48px; max-width: 720px;">
				<span class="eyebrow">The three primitives</span>
				<h2 class="h-1">Every conversation, mapped to three shapes.</h2>
				<p class="lede">No likes, no quote-replies, no algorithmic feed.
					Each contribution is one of three kinds — and every connection is named.</p>
			</div>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
				@primitiveCard("topic", "Topic", "Big questions you want to think about — UBI, AI alignment, urban transit. Containers for opinions.")
				@primitiveCard("view", "Opinion", "A specific stance someone could commit to. Sharper than a topic, debatable as a sentence.")
				@primitiveCard("finding", "Evidence", "An argument or piece of reasoning. Whether reasoned or sourced, it supports or contests an opinion — and can be challenged on its own.")
			</div>
			<div class="card" style="margin-top: 32px; padding: 28px;">
				<div class="row between wrap gap-16" style="margin-bottom: 18px;">
					<div>
						<span class="eyebrow">Edges</span>
						<div class="h-2" style="margin-top: 4px;">Three named relationships.</div>
					</div>
					<p class="muted" style="margin: 0; max-width: 360px; font-size: 14px;">
						Every link between two nodes carries a kind — so disagreement is structural, not interpretive.
					</p>
				</div>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
					@edgeCard("supports", "supports", "argues in favor")
					@edgeCard("opposes", "opposes", "argues against")
					@edgeCard("related", "related", "loose link, citation, or clarification")
				</div>
			</div>
		</div>
	</section>
	<section class="section-cream">
		<div class="page" style="padding-top: 80px; padding-bottom: 80px;">
			<div class="col gap-12" style="margin-bottom: 40px; max-width: 700px;">
				<span class="eyebrow">How it works</span>
				<h2 class="h-1">From scrolling to thinking.</h2>
			</div>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
				@stepCard("01", "Find a topic you care about", "Browse topics by tag. Sub-opinions and evidence chains expand below.")
				@stepCard("02", "Read the opinions and their evidence", "Each opinion shows who commits, opposing opinions, and cited evidence.")
				@stepCard("03", "Share your own evidence", "Take a stance — Support, Oppose, or Resonate — then link the evidence that shaped it.")
				@stepCard("04", "Watch the graph rebuild itself", "Your contribution rewires the conversation — visible, named, accountable.")
			</div>
		</div>
	</section>
	<section class="page" style="padding-top: 100px; padding-bottom: 120px;">
		<div class="card" style="padding: 64px 48px; text-align: center; position: relative; overflow: hidden; background: linear-gradient(135deg, var(--paper), var(--bg-2));">
			@bloom(200, 105, "position: absolute; left: -50px; top: -40px; opacity: 0.6;")
			@bloom(160, 35, "position: absolute; right: -30px; bottom: -40px; opacity: 0.6;")
			<div style="position: relative; z-index: 2; max-width: 640px; margin: 0 auto;">
				<h2 class="h-1" style="font-size: 56px;">Stop dunking. Start <em style="font-style: italic; color: var(--accent-deep);">thinking together.</em></h2>
				<p class="lede" style="margin: 20px auto 32px;">
					Free forever. No ads. No algorithm. Just you, your evidence, and a slowly-better-organized internet.
				</p>
				<div class="row gap-12" style="justify-content: center;">
					if SignupEnabled() {
						<a class="btn accent lg" href="/signup">Create your account</a>
						<a class="btn lg" href="/login">I already have one</a>
					} else {
						<a class="btn accent lg" href="/login">Sign in</a>
					}
				</div>
			</div>
		</div>
	</section>
	@siteFooter(viewer)
}

// landingRecent shows a small teaser of recent visible nodes so first-time
// visitors see real content instead of pure marketing copy. Hidden when there
// are no visible nodes for the viewer (e.g. fresh install, anonymous + only
// private content). Sits right under the hero so visitors land on real
// community content before reading the marketing primitives.
templ landingRecent(items []FeedItem) {
	if len(items) > 0 {
		<section class="page" style="padding-top: 0; padding-bottom: 16px;">
			<div class="row between wrap gap-16" style="margin-bottom: 24px;">
				<h2 class="h-2" style="margin: 0; max-width: 560px;">Hot Today</h2>
				<a class="btn" href="/graph">Open graph</a>
			</div>
			<div class="recent-grid">
				for _, n := range items {
					@recentNodeCard(n)
				}
			</div>
		</section>
	}
}

// recentNodeCard is one tile of the landing teaser grid. The title link's
// stretched ::after pseudo turns the whole card into a click target for the
// node page; the author byline lives in its own stacking context so its
// /users/{username} link still wins clicks over the stretched overlay.
templ recentNodeCard(n FeedItem) {
	<article class="card recent-card">
		<div class="recent-card-meta">
			<span class={ "chip", string(n.Type) } title={ nodeTypeOriginalLabel(n.Type) }>
				<span class="dot"></span>
				{ nodeTypeAliasLabel(n.Type) }
			</span>
			<a class="recent-card-author" href={ templ.SafeURL("/users/" + n.AuthorUsername) }>
				@Avatar(n.AuthorUsername, 18)
				{ n.AuthorUsername }
			</a>
		</div>
		<a class="recent-card-title" href={ templ.SafeURL("/nodes/" + n.Slug) }>{ n.Title }</a>
		if excerpt := NodePlainExcerpt(n.Body, 480); excerpt != "" {
			<p class="recent-card-body">{ excerpt }</p>
		}
	</article>
}

templ homeFeed(viewer *Viewer, items []FeedItem) {
	<div class="page">
		<section class="col gap-16" style="margin-bottom: 32px;">
			<span class="eyebrow">Welcome back, { viewer.Username }</span>
			<h1 class="h-1">What do you want to commit to today?</h1>
			<div class="row gap-12 wrap">
				<a class="btn accent" href="/nodes/new">Add a node</a>
				<a class="btn" href="/graph">Open graph</a>
				<a class="btn" href="/tags">Browse by tag</a>
			</div>
		</section>
		<section class="col gap-12">
			<div class="row between wrap gap-12">
				<span class="eyebrow">Recent nodes</span>
				<a class="muted" href="/tags" style="font-size: 13px; text-decoration: none;">All tags →</a>
			</div>
			if len(items) == 0 {
				<div class="card muted" style="padding: 24px; text-align: center;">
					The graph is empty. <a href="/nodes/new" style="color: var(--ink); font-weight: 500;">Be the first to add a node.</a>
				</div>
			} else {
				<ul class="node-list">
					for _, n := range items {
						<li>
							<div class="node-feed-top">
								<a href={ templ.SafeURL("/nodes/" + n.Slug) }>
									<span class={ "chip", string(n.Type) } title={ nodeTypeOriginalLabel(n.Type) }>
										<span class="dot"></span>
										{ nodeTypeAliasLabel(n.Type) }
									</span>
									<span class="title">{ n.Title }</span>
								</a>
								<a href={ templ.SafeURL("/users/" + n.AuthorUsername) } class="node-author">
									@Avatar(n.AuthorUsername, 18)
									{ n.AuthorUsername }
								</a>
							</div>
							if excerpt := NodePlainExcerpt(n.Body, 200); excerpt != "" {
								<p class="node-feed-excerpt">{ excerpt }</p>
							}
							@feedVoteBar(n.SupportsCount, n.OpposesCount)
						</li>
					}
				</ul>
			}
		</section>
		@argumentGraphPromo()
	</div>
}

// argumentGraphPromo is the home-feed callout for the visual graph.
templ argumentGraphPromo() {
	<section class="promo" aria-label="Argument graph" style="margin-top: 56px;">
		<div class="promo-inner">
			<span class="badge accent">Live graph</span>
			<h2>The argument graph</h2>
			<p>See how topics, opinions, and evidence connect — and trace any claim back to what supports or opposes it.</p>
			<a class="btn accent" href="/graph">Open graph</a>
		</div>
		<div class="promo-graph" aria-hidden="true">
			<svg viewBox="0 0 360 280" preserveAspectRatio="xMaxYMid meet">
				<defs>
					<radialGradient id="bubble-topic" cx="35%" cy="28%" r="75%">
						<stop offset="0%" stop-color="oklch(98% 0.04 250)"></stop>
						<stop offset="18%" stop-color="oklch(86% 0.13 250)"></stop>
						<stop offset="55%" stop-color="oklch(64% 0.17 260)"></stop>
						<stop offset="100%" stop-color="oklch(40% 0.12 265)"></stop>
					</radialGradient>
					<radialGradient id="bubble-view" cx="35%" cy="28%" r="75%">
						<stop offset="0%" stop-color="oklch(98% 0.04 22)"></stop>
						<stop offset="18%" stop-color="oklch(86% 0.14 22)"></stop>
						<stop offset="55%" stop-color="oklch(64% 0.17 25)"></stop>
						<stop offset="100%" stop-color="oklch(40% 0.12 25)"></stop>
					</radialGradient>
					<radialGradient id="bubble-reasoning" cx="35%" cy="28%" r="75%">
						<stop offset="0%" stop-color="oklch(98% 0.04 168)"></stop>
						<stop offset="18%" stop-color="oklch(86% 0.14 168)"></stop>
						<stop offset="55%" stop-color="oklch(60% 0.16 168)"></stop>
						<stop offset="100%" stop-color="oklch(38% 0.10 168)"></stop>
					</radialGradient>
					<radialGradient id="bubble-fact" cx="35%" cy="28%" r="75%">
						<stop offset="0%" stop-color="oklch(98% 0.04 332)"></stop>
						<stop offset="18%" stop-color="oklch(86% 0.14 332)"></stop>
						<stop offset="55%" stop-color="oklch(64% 0.18 340)"></stop>
						<stop offset="100%" stop-color="oklch(40% 0.13 340)"></stop>
					</radialGradient>
					<radialGradient id="bubble-small" cx="35%" cy="28%" r="75%">
						<stop offset="0%" stop-color="oklch(96% 0.02 250)"></stop>
						<stop offset="55%" stop-color="oklch(72% 0.05 250)"></stop>
						<stop offset="100%" stop-color="oklch(48% 0.04 250)"></stop>
					</radialGradient>
					<linearGradient id="hi-shine" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="oklch(100% 0 0 / 0.95)"></stop>
						<stop offset="60%" stop-color="oklch(100% 0 0 / 0.15)"></stop>
						<stop offset="100%" stop-color="oklch(100% 0 0 / 0)"></stop>
					</linearGradient>
					<radialGradient id="rim-soft" cx="50%" cy="95%" r="60%">
						<stop offset="0%" stop-color="oklch(100% 0 0 / 0.30)"></stop>
						<stop offset="100%" stop-color="oklch(100% 0 0 / 0)"></stop>
					</radialGradient>
					<filter id="ball-shadow" x="-30%" y="-30%" width="160%" height="160%">
						<feGaussianBlur in="SourceAlpha" stdDeviation="3"></feGaussianBlur>
						<feOffset dx="0" dy="3" result="off"></feOffset>
						<feComponentTransfer><feFuncA type="linear" slope="0.55"></feFuncA></feComponentTransfer>
						<feMerge><feMergeNode></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
					</filter>
				</defs>
				<g stroke-width="1.2" fill="none" opacity="0.45" stroke-linecap="round">
					<path d="M180 140 C 220 100 240 90 260 80" stroke="oklch(75% 0.14 250)"></path>
					<path d="M180 140 C 220 170 250 195 270 200" stroke="oklch(70% 0.14 168)"></path>
					<path d="M180 140 C 140 120 110 100 90 90" stroke="oklch(70% 0.16 50)"></path>
					<path d="M180 140 C 140 170 110 195 80 200" stroke="oklch(72% 0.15 332)"></path>
					<path d="M260 80 C 290 110 310 130 320 150" stroke="oklch(72% 0.10 200)"></path>
				</g>
				<g filter="url(#ball-shadow)">
					<g>
						<circle cx="180" cy="140" r="40" fill="url(#bubble-topic)"></circle>
						<circle cx="180" cy="140" r="40" fill="url(#rim-soft)"></circle>
						<ellipse cx="170" cy="120" rx="22" ry="13" fill="url(#hi-shine)" opacity="0.9"></ellipse>
					</g>
					<g>
						<circle cx="260" cy="80" r="28" fill="url(#bubble-view)"></circle>
						<circle cx="260" cy="80" r="28" fill="url(#rim-soft)"></circle>
						<ellipse cx="253" cy="66" rx="15" ry="9" fill="url(#hi-shine)" opacity="0.9"></ellipse>
					</g>
					<g>
						<circle cx="270" cy="200" r="26" fill="url(#bubble-reasoning)"></circle>
						<circle cx="270" cy="200" r="26" fill="url(#rim-soft)"></circle>
						<ellipse cx="263" cy="187" rx="14" ry="8" fill="url(#hi-shine)" opacity="0.9"></ellipse>
					</g>
					<g>
						<circle cx="92" cy="90" r="24" fill="url(#bubble-fact)"></circle>
						<circle cx="92" cy="90" r="24" fill="url(#rim-soft)"></circle>
						<ellipse cx="86" cy="78" rx="12" ry="7" fill="url(#hi-shine)" opacity="0.9"></ellipse>
					</g>
					<g>
						<circle cx="82" cy="202" r="22" fill="url(#bubble-view)"></circle>
						<circle cx="82" cy="202" r="22" fill="url(#rim-soft)"></circle>
						<ellipse cx="76" cy="191" rx="11" ry="6" fill="url(#hi-shine)" opacity="0.9"></ellipse>
					</g>
					<g>
						<circle cx="324" cy="148" r="10" fill="url(#bubble-small)"></circle>
						<ellipse cx="321" cy="144" rx="5" ry="3" fill="url(#hi-shine)" opacity="0.85"></ellipse>
					</g>
				</g>
			</svg>
		</div>
	</section>
}

templ feedVoteBar(supports, opposes int64) {
	if supports+opposes > 0 {
		<div class="node-feed-bar">
			<div class="stance-bar node-feed-stance">
				<span class="stance-fill" style={ feedSupportBarStyle(supports, opposes) }></span>
			</div>
			<span class="node-feed-votes">{ fmt.Sprintf("%d support · %d oppose", supports, opposes) }</span>
		</div>
	}
}

func feedSupportBarStyle(supports, opposes int64) string {
	total := supports + opposes
	if total == 0 {
		return "width:50%"
	}
	return fmt.Sprintf("width:%.0f%%", float64(supports)/float64(total)*100)
}

templ checkIcon() {
	<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7l3 3 7-7" stroke="var(--supports)" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
}

templ bloom(size int, hue int, style string) {
	<div aria-hidden="true" class="bloom" style={ bloomStyle(size, hue, style) }></div>
}

func bloomStyle(size int, hue int, extra string) string {
	return fmt.Sprintf(
		"width:%dpx;height:%dpx;background:radial-gradient(circle at 32%% 28%%, oklch(0.95 0.10 %d) 0%%, oklch(0.78 0.18 %d) 50%%, oklch(0.55 0.18 %d) 100%%);box-shadow:inset -20px -28px 60px oklch(0.42 0.18 %d / 0.5), inset 18px 22px 40px oklch(0.98 0.05 %d / 0.6), 0 30px 80px -20px oklch(0.60 0.18 %d / 0.45);%s",
		size, size, hue, hue, hue+5, hue+10, hue, hue, extra,
	)
}

templ primitiveCard(typ, label, blurb string) {
	<div class="card" style="display: flex; flex-direction: column; gap: 16px;">
		<span class={ "chip", typ } style="padding: 6px 14px; font-size: 13px; align-self: flex-start;">
			<span class="dot"></span>
			{ label }
		</span>
		<p class="muted" style="margin: 0; font-size: 14px;">{ blurb }</p>
	</div>
}

templ edgeCard(kind, label, blurb string) {
	<div class={ "edge-" + kind } style="display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--bg);">
		<span class="edge-dot" style="width: 10px; height: 10px;"></span>
		<div class="col gap-4">
			<div style="font-family: var(--mono); font-size: 13px; color: var(--edge);">{ label }</div>
			<div class="muted" style="font-size: 12px;">{ blurb }</div>
		</div>
	</div>
}

templ stepCard(num, title, body string) {
	<div class="card" style="background: var(--paper);">
		<div class="eyebrow" style="color: var(--accent-deep); margin-bottom: 16px;">{ num }</div>
		<div class="h-3" style="margin-bottom: 8px;">{ title }</div>
		<p class="muted" style="margin: 0; font-size: 14px;">{ body }</p>
	</div>
}

templ siteFooter(viewer *Viewer) {
	<footer class="site-footer">
		<div class="page" style="padding-top: 48px; padding-bottom: 48px;">
			<div class="row between wrap gap-16">
				<div class="row gap-12 center">
					<span class="brand-mark" style="width: 22px; height: 22px;"></span>
					<span style="font-family: var(--serif); font-size: 18px;">Mindful Social</span>
					<span class="muted" style="font-size: 12px; font-family: var(--mono);">v{ Version() } · early development</span>
				</div>
				<div class="row gap-24 wrap" style="font-size: 13px; color: var(--ink-3);">
					if viewer != nil {
						<a href="/home" style="text-decoration: none;">Home</a>
					} else {
						<a href="/" style="text-decoration: none;">Home</a>
					}
					<a href="/tags" style="text-decoration: none;">Tags</a>
					<a href="/search" style="text-decoration: none;">Search</a>
					<a href={ templ.SafeURL(SourceURL) } rel="noopener" target="_blank" style="text-decoration: none;">Source</a>
				</div>
			</div>
		</div>
	</footer>
}
