package views

import (
	"github.com/google/uuid"
	"github.com/mindful-social/mindful-social/internal/db"
)

// PinRow is one entry in the "On profile" section: the pinned node and the
// kind of pin (supports / opposes / featured), with an optional reasoning.
type PinRow struct {
	NodeID         uuid.UUID
	NodeType       db.NodeType
	NodeTitle      string
	Kind           db.PinKind
	ReasoningID    *uuid.UUID
	ReasoningTitle string
}

// pinKindShort is the inline label rendered next to each pin row on a
// profile, e.g. "Supports", "Opposes", "Featured".
func pinKindShort(k db.PinKind) string {
	switch k {
	case db.PinKindSupports:
		return "Supports"
	case db.PinKindOpposes:
		return "Opposes"
	case db.PinKindFeatured:
		return "Featured"
	}
	return string(k)
}

templ Profile(viewer *Viewer, profile db.User, isSelf bool, authored []db.Node, pins []PinRow, identities []string) {
	@Layout(profile.Username+" — profile", viewer) {
		<section class="profile">
			<header class="profile-head">
				<h1>{ profile.Username }</h1>
				<p class="muted">
					Joined { profile.CreatedAt.Time.Format("January 2006") }
					if isSelf {
						· <span>this is you</span>
					}
				</p>
			</header>

			if isSelf && len(identities) > 0 {
				<section class="profile-identities">
					<h2>Sign-in methods</h2>
					<ul class="identity-list">
						for _, label := range identities {
							<li>{ label }</li>
						}
					</ul>
				</section>
			}

			<section class="profile-pins">
				<h2>On profile</h2>
				if len(pins) == 0 {
					<p class="muted">
						if isSelf {
							You haven't pinned any nodes yet.
						} else {
							No public pins.
						}
					</p>
				} else {
					<ul class="pin-list">
						for _, p := range pins {
							<li class={ "pin-row", "pin-" + string(p.Kind) }>
								<span class="pin-kind">{ pinKindShort(p.Kind) }</span>
								<a href={ templ.SafeURL("/nodes/" + p.NodeID.String()) } class="pin-node">
									<span class={ "badge", "badge-" + string(p.NodeType) }>{ string(p.NodeType) }</span>
									<span class="title">{ p.NodeTitle }</span>
								</a>
								if p.ReasoningID != nil {
									<div class="pin-reasoning">
										via
										<a href={ templ.SafeURL("/nodes/" + p.ReasoningID.String()) }>{ p.ReasoningTitle }</a>
									</div>
								}
							</li>
						}
					</ul>
				}
			</section>

			<section class="profile-authored">
				<h2>Authored nodes</h2>
				if len(authored) == 0 {
					<p class="muted">
						if isSelf {
							You haven't authored any nodes yet. <a href="/nodes/new">Create one</a>.
						} else {
							No authored nodes yet.
						}
					</p>
				} else {
					<ul class="node-list">
						for _, n := range authored {
							<li>
								<a href={ templ.SafeURL("/nodes/" + n.ID.String()) }>
									<span class={ "badge", "badge-" + string(n.Type) }>{ string(n.Type) }</span>
									<span class="title">{ n.Title }</span>
								</a>
							</li>
						}
					</ul>
				}
			</section>
		</section>
	}
}
