package views

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/TuotHash/mindful-social/internal/db"
)

func followerLabel(n int64) string {
	if n == 1 {
		return "1 follower"
	}
	return fmt.Sprintf("%d followers", n)
}

func followingLabel(n int64) string {
	return fmt.Sprintf("%d following", n)
}

// PinRow is one entry in the "On profile" section: the pinned node and
// the stance (supports / opposes / featured). Evidence the pinner
// wants to surface lives in the typed-edge graph, not on the pin.
type PinRow struct {
	NodeID    uuid.UUID
	NodeSlug  string
	NodeType  db.NodeType
	NodeTitle string
	Kind      db.PinKind
}

// FollowRelation captures the follow relationship between the viewer and
// the profile being rendered. ViewerFollows / FollowsViewer are zero when
// the viewer is logged-out or looking at their own profile.
type FollowRelation struct {
	Followers     int64
	Following     int64
	ViewerFollows bool
	FollowsViewer bool
}

// IsConnection reports whether the viewer and the profile have a mutual
// follow — the platform's notion of "friends".
func (r FollowRelation) IsConnection() bool {
	return r.ViewerFollows && r.FollowsViewer
}

// pinKindShort is the inline label rendered next to each pin row on a
// profile, e.g. "Supports", "Opposes", "Resonates".
func pinKindShort(k db.PinKind) string {
	switch k {
	case db.PinKindSupports:
		return "Supports"
	case db.PinKindOpposes:
		return "Opposes"
	case db.PinKindFeatured:
		return "Resonates"
	}
	return string(k)
}

templ Profile(viewer *Viewer, profile db.User, isSelf bool, authored []db.Node, pins []PinRow, relation FollowRelation) {
	@Layout(profile.Username+" — profile", viewer) {
		<div class="page medium">
			<section class="profile">
				<div class="profile-head">
					@bloom(240, 105, "position: absolute; right: -40px; top: -60px; opacity: 0.5;")
					<div style="position: relative; z-index: 2;">
						<div class="row gap-24 wrap" style="align-items: flex-start;">
							@AvatarImage(profile.Username, profile.ProfileImagePath, 88)
							<div class="col gap-8 grow" style="min-width: 240px;">
								<div class="row gap-12 wrap" style="align-items: center;">
									<h1 style="margin: 0;">{ profile.Username }</h1>
									if profile.Role == db.UserRoleAdmin {
										<span class="badge danger">Admin</span>
									} else if profile.Role == db.UserRoleModerator {
										<span class="badge accent">Moderator</span>
									}
								</div>
								<div class="row gap-12 wrap muted" style="font-size: 13px; font-family: var(--mono);">
									<span>Joined { profile.CreatedAt.Time.In(viewer.Location()).Format("January 2006") }</span>
									<span>·</span>
									<span>{ followerLabel(relation.Followers) }</span>
									<span>·</span>
									<span>{ followingLabel(relation.Following) }</span>
									if isSelf {
										<span>·</span><span>this is you</span>
									} else if relation.IsConnection() {
										<span>·</span><span class="badge accent">Connection</span>
									} else if relation.FollowsViewer {
										<span>·</span><span>follows you</span>
									}
								</div>
							</div>
							if !isSelf && viewer != nil {
								<div class="col gap-8">
									if relation.ViewerFollows {
										<form method="post" action={ templ.SafeURL("/users/" + profile.Username + "/unfollow") } class="inline">
											@CSRFField()
											<button class="btn ghost" type="submit">Following</button>
										</form>
									} else {
										<form method="post" action={ templ.SafeURL("/users/" + profile.Username + "/follow") } class="inline">
											@CSRFField()
											<button class="btn accent" type="submit">+ Follow</button>
										</form>
									}
								</div>
							}
						</div>
					</div>
				</div>

				<section>
					<h2>On profile</h2>
					if len(pins) == 0 {
						<div class="card muted" style="text-align: center; padding: 24px;">
							if isSelf {
								You haven't pinned any nodes yet.
							} else {
								No public pins.
							}
						</div>
					} else {
						<ul class="pin-list">
							for _, p := range pins {
								<li class={ "pin-row", "pin-" + string(p.Kind) }>
									<span class="pin-kind">{ pinKindShort(p.Kind) }</span>
									<a href={ templ.SafeURL("/nodes/" + p.NodeSlug) } class="pin-node">
										<span class={ "chip", string(p.NodeType) }>
											<span class="dot"></span>
											{ string(p.NodeType) }
										</span>
										<span class="title">{ p.NodeTitle }</span>
									</a>
								</li>
							}
						</ul>
					}
				</section>

				<section>
					<h2>Authored nodes</h2>
					if len(authored) == 0 {
						<div class="card muted" style="text-align: center; padding: 24px;">
							if isSelf {
								You haven't authored any nodes yet. <a href="/nodes/new" style="color: var(--ink); font-weight: 500;">Create one</a>.
							} else {
								No authored nodes yet.
							}
						</div>
					} else {
						<ul class="node-list">
							for _, n := range authored {
								<li>
									<a href={ templ.SafeURL("/nodes/" + n.Slug) }>
										<span class={ "chip", string(n.Type) }>
											<span class="dot"></span>
											{ string(n.Type) }
										</span>
										<span class="title">{ n.Title }</span>
									</a>
								</li>
							}
						</ul>
					}
				</section>
			</section>
		</div>
	}
}
