package views

import (
	"fmt"
	"time"
)

// Layout is the shared chrome around every page. Title is set per-page.
// CurrentUser is rendered in the header when set; nil means logged-out.
templ Layout(title string, currentUser *Viewer) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ CSRFToken(ctx) }/>
			<title>{ title } — Mindful Social</title>
			<link rel="icon" type="image/svg+xml" href={ StaticAsset("/static/favicon/favicon.svg") }/>
			<link rel="icon" type="image/x-icon" href={ StaticAsset("/static/favicon/favicon.ico") }/>
			<link rel="icon" type="image/png" sizes="96x96" href={ StaticAsset("/static/favicon/favicon-96x96.png") }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ StaticAsset("/static/favicon/apple-touch-icon.png") }/>
			<link rel="manifest" href={ StaticAsset("/static/favicon/site.webmanifest") }/>
			<meta name="theme-color" content="#0b9ec8"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/>
			<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" rel="stylesheet"/>
			<link rel="stylesheet" href={ StaticAsset("/static/easymde.min.css") }/>
			<link rel="stylesheet" href={ StaticAsset("/static/app.css") }/>
			<script>
				(function () {
					var t = 'dark';
					try {
						var s = localStorage.getItem('theme');
						if (s === 'light') t = 'light';
					} catch (e) {}
					document.documentElement.setAttribute('data-theme', t);
				})();
			</script>
			<script src={ StaticAsset("/static/htmx.min.js") } defer></script>
			<script src={ StaticAsset("/static/easymde.min.js") } defer></script>
			<script src={ StaticAsset("/static/app.js") } defer></script>
			<script>
				// Forward the CSRF token on every htmx request from the
				// meta tag above so hx-post/hx-delete etc. don't need
				// per-form wiring. gorilla/csrf accepts X-CSRF-Token.
				document.addEventListener('htmx:configRequest', function (evt) {
					var meta = document.querySelector('meta[name="csrf-token"]');
					if (meta) evt.detail.headers['X-CSRF-Token'] = meta.getAttribute('content');
				});
			</script>
		</head>
		<body>
			<div class="app">
				@TopNav(currentUser)
				<main>
					{ children... }
				</main>
			</div>
			<div id="modal" class="modal-host"></div>
			<script>
				(function () {
					var btn = document.getElementById('theme-toggle');
					if (!btn) return;
					var html = document.documentElement;
					function sync() {
						var dark = html.getAttribute('data-theme') === 'dark';
						btn.textContent = dark ? '☀' : '☾';
						btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
					}
					sync();
					btn.addEventListener('click', function () {
						var dark = html.getAttribute('data-theme') === 'dark';
						var next = dark ? 'light' : 'dark';
						html.setAttribute('data-theme', next);
						try { localStorage.setItem('theme', next); } catch (e) {}
						sync();
					});
				})();
			</script>
			<script>
				(function () {
					document.addEventListener('click', function (e) {
						document.querySelectorAll('details.user-menu[open]').forEach(function (d) {
							if (!d.contains(e.target)) d.removeAttribute('open');
						});
					});
					document.addEventListener('keydown', function (e) {
						if (e.key !== 'Escape') return;
						document.querySelectorAll('details.user-menu[open]').forEach(function (d) {
							d.removeAttribute('open');
						});
					});
				})();
			</script>
		</body>
	</html>
}

templ TopNav(currentUser *Viewer) {
	<header class="nav">
		<div class="nav-inner">
			<a class="brand" href="/">
				<span class="brand-mark"></span>
				<span>Mindful Social</span>
			</a>
			<div class="nav-links">
				if currentUser != nil {
					<a class="nav-link" href="/home">Home</a>
				} else {
					<a class="nav-link" href="/">Home</a>
				}
				<a class="nav-link" href="/graph">Graph</a>
				<a class="nav-link" href="/tags">Browse</a>
				<a class="nav-link" href="/groups">Groups</a>
				if currentUser != nil {
					<a
						class="nav-link"
						href="/nodes/new"
						hx-get="/nodes/new"
						hx-target="#modal"
						hx-swap="innerHTML"
					>Post</a>
				}
			</div>
			<span class="nav-spacer"></span>
			<form method="get" action="/search" class="nav-search" role="search">
				<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
					<circle cx="6" cy="6" r="4.2" stroke="currentColor" stroke-width="1.4" fill="none"></circle>
					<path d="M9.2 9.2L12 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
				</svg>
				<input
					type="search"
					name="q"
					placeholder="Search people and nodes..."
					aria-label="Search"
					autocomplete="off"
					hx-get="/search/suggest"
					hx-trigger="input changed delay:200ms"
					hx-target="#nav-suggest"
					hx-swap="innerHTML"
				/>
				<div id="nav-suggest" class="search-suggest" hidden></div>
			</form>
			<button id="theme-toggle" class="theme-toggle" type="button" title="Toggle theme" aria-label="Toggle theme">☀</button>
			if currentUser != nil {
				<details class="user-menu">
					<summary class="user-menu-trigger" aria-label="Account menu">
						@AvatarImage(currentUser.Username, currentUser.ProfileImagePath, 28)
						<span class="user-menu-name">{ currentUser.Username }</span>
						<span class="material-symbols-outlined user-menu-caret">arrow_drop_down</span>
					</summary>
					<div class="user-menu-panel" role="menu">
						<a class="user-menu-item" href={ templ.SafeURL("/users/" + currentUser.Username) } role="menuitem">Profile</a>
						<a class="user-menu-item" href="/account" role="menuitem">Account</a>
						<a class="user-menu-item" href="#" role="menuitem">Settings</a>
						<a class="user-menu-item" href="/groups" role="menuitem">Groups</a>
						if currentUser.IsAdmin {
							<div class="user-menu-divider"></div>
							<a class="user-menu-item" href="/admin" role="menuitem">Admin</a>
						}
						<div class="user-menu-divider"></div>
						<form method="post" action="/logout" class="user-menu-form">
							@CSRFField()
							<button type="submit" class="user-menu-item" role="menuitem">Log out</button>
						</form>
					</div>
				</details>
			} else {
				<a class="btn ghost" href="/login">Sign in</a>
				if SignupEnabled() {
					<a class="btn accent" href="/signup">Get started</a>
				}
			}
		</div>
	</header>
}

// Avatar renders a deterministic-coloured circle with the first two letters of
// the username. Hue derives from the username so a user always gets the same
// background across pages.
templ Avatar(username string, size int) {
	@AvatarImage(username, "", size)
}

templ AvatarImage(username, imagePath string, size int) {
	if imagePath != "" {
		<img
			class="avatar"
			src={ templ.SafeURL(imagePath) }
			alt=""
			width={ fmt.Sprintf("%d", size) }
			height={ fmt.Sprintf("%d", size) }
			style={ avatarImageStyle(size) }
		/>
	} else {
	<span
		class="avatar"
		style={ avatarStyle(username, size) }
	>{ avatarInitials(username) }</span>
	}
}

func avatarHue(s string) int {
	h := 0
	for _, c := range s {
		h = (h*31 + int(c)) % 360
	}
	return h
}

func avatarInitials(username string) string {
	if username == "" {
		return "?"
	}
	r := []rune(username)
	if len(r) == 1 {
		return string(r)
	}
	return string(r[0:2])
}

func avatarStyle(username string, size int) string {
	hue := avatarHue(username)
	return fmt.Sprintf(
		"display:inline-flex;align-items:center;justify-content:center;width:%dpx;height:%dpx;border-radius:50%%;background:oklch(0.86 0.07 %d);color:oklch(0.32 0.10 %d);font-size:%dpx;font-weight:600;font-family:var(--mono);letter-spacing:-0.02em;flex:none;",
		size, size, hue, hue, int(float64(size)*0.4),
	)
}

func avatarImageStyle(size int) string {
	return fmt.Sprintf("width:%dpx;height:%dpx;border-radius:50%%;object-fit:cover;display:inline-block;flex:none;", size, size)
}

// Viewer is the small slice of user info templates need. We avoid passing
// the full db.User so views don't depend on database types.
type Viewer struct {
	ID               string
	Username         string
	ProfileImagePath string
	IsAdmin          bool
	IsStaff          bool   // admins or moderators — used to flag curation UI
	Timezone         string // IANA name; empty = UTC fallback
}

// Location returns the viewer's preferred IANA location, falling back to
// UTC when the viewer is nil, has no preference set, or the stored name
// can't be loaded (e.g. tzdata changed). Used wherever a timestamp is
// rendered for a logged-in user.
func (v *Viewer) Location() *time.Location {
	if v == nil || v.Timezone == "" {
		return time.UTC
	}
	loc, err := time.LoadLocation(v.Timezone)
	if err != nil {
		return time.UTC
	}
	return loc
}

// Flash is a one-shot banner message rendered above forms.
templ Flash(msg string) {
	if msg != "" {
		<div class="flash" role="alert">{ msg }</div>
	}
}

// CSRFField renders the hidden input that gorilla/csrf checks on unsafe
// methods. Include it in every non-GET form. htmx posts get the token via
// the meta tag + htmx:configRequest listener wired in Layout above.
templ CSRFField() {
	<input type="hidden" name="gorilla.csrf.Token" value={ CSRFToken(ctx) }/>
}
